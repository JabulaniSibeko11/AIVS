@model List<AIVS.Models.ViewModels.ValuerInbox.ValuerInboxItemVm>
@using System.Globalization
@using AIVS.Workflow
@inject AIVS.Services.Interface.IUserManagementService UserManagementService
@inject AIVS.Services.Interface.IAivsRoleAccessService RoleAccess

@{
    ViewData["Title"] = "My Reviews";

    var currentUser = await UserManagementService.GetCurrentUserAsync(User);

    // "Processor" never means anything to the person looking at the
    // screen — on this page the assignee is always whoever is logged
    // in, so swap it for their actual role label everywhere it appears.
    var selfRoleLabel = RoleAccess.IsSectorManager(currentUser)
        ? "Sector Manager"
        : "Valuer";

    string StatusText(string? status) =>
        AttributeWorkflowStatus.Display(status).Replace("Processor", selfRoleLabel);

    string StatusBadgeClass(string? status) => (status?.Trim()) switch
    {
        "Claimed" => "vi-badge-claimed",
        "ValuerReview" => "vi-badge-review",

        "ReturnedToClient" => "vi-badge-returned",
        "Resubmitted" => "vi-badge-resubmitted",
        "ReturnedToValuer" => "vi-badge-returned",

        "InspectionRequired" => "vi-badge-waiting",
        "InspectionConfirmed" => "vi-badge-confirmed",
        "InspectionDetailsSent" => "vi-badge-sent",
        "InspectionCompleted" => "vi-badge-completed",
        "InspectionExpired" => "vi-badge-expired",

        "SectorManagerQa" => "vi-badge-qa",
        "ReadyForOvvioExtract" => "vi-badge-ready",
        "OvvioExtracted" => "vi-badge-extracted",

        _ => "vi-badge-default"
    };

    string StatusIcon(string? status) => (status?.Trim()) switch
    {
        "Claimed" => "fa-inbox",
        "ValuerReview" => "fa-magnifying-glass",

        "ReturnedToClient" => "fa-rotate-left",
        "Resubmitted" => "fa-arrow-rotate-right",
        "ReturnedToValuer" => "fa-triangle-exclamation",

        "InspectionRequired" => "fa-clock",
        "InspectionConfirmed" => "fa-calendar-check",
        "InspectionDetailsSent" => "fa-paper-plane",
        "InspectionCompleted" => "fa-circle-check",
        "InspectionExpired" => "fa-clock-rotate-left",

        "SectorManagerQa" => "fa-user-shield",
        "ReadyForOvvioExtract" => "fa-circle-check",
        "OvvioExtracted" => "fa-box-archive",

        _ => "fa-circle"
    };

    string StatusColor(string? status) => (status?.Trim()) switch
    {
        "Claimed" => "var(--aivs-grey)",
        "ValuerReview" => "var(--aivs-orange)",

        "ReturnedToClient" => "var(--aivs-danger)",
        "Resubmitted" => "var(--aivs-info)",
        "ReturnedToValuer" => "var(--aivs-danger)",

        "InspectionRequired" => "var(--aivs-gold-dark)",
        "InspectionConfirmed" => "var(--aivs-success)",
        "InspectionDetailsSent" => "var(--aivs-info)",
        "InspectionCompleted" => "var(--aivs-success)",
        "InspectionExpired" => "var(--aivs-danger)",

        "SectorManagerQa" => "var(--aivs-gold-dark)",
        "ReadyForOvvioExtract" => "var(--aivs-success)",
        "OvvioExtracted" => "var(--aivs-success)",

        _ => "var(--aivs-border)"
    };

    int StatusPriority(string? status) => AttributeWorkflowStatus.Priority(status);

    string ButtonText(AIVS.Models.ViewModels.ValuerInbox.ValuerInboxItemVm item) => (item.Status?.Trim()) switch
    {
        "Claimed" => "Open Review",
        "ValuerReview" => "Continue Review",

        "Resubmitted" => "Review Resubmission",
        "ReturnedToValuer" => "Fix Returned Review",

        "InspectionConfirmed" => "Send PIN",
        "InspectionDetailsSent" => "View Inspection",
        "InspectionRequired" => "Check Response",
        "InspectionCompleted" => "Continue Review",
        "InspectionExpired" => "Send New Dates",

        "SectorManagerQa" => "Awaiting Team QA",
        "ReadyForOvvioExtract" => "View Finalised Review",
        "OvvioExtracted" => "View Extracted Review",

        _ => item.ReviewStarted ? "Continue Review" : "Open Review"
    };

    var allItems = Model ?? new List<AIVS.Models.ViewModels.ValuerInbox.ValuerInboxItemVm>();

    var orderedItems = allItems
        .OrderBy(x => StatusPriority(x.Status))
        .ThenByDescending(x => x.AssignedDate)
        .ToList();

    var statusChips = orderedItems
        .GroupBy(x => x.Status?.Trim() ?? "")
        .Select(g => new
        {
            StatusKey = g.Key,
            Label = StatusText(g.Key),
            Icon = StatusIcon(g.Key),
            Count = g.Count(),
            Priority = StatusPriority(g.Key)
        })
        .OrderBy(g => g.Priority)
        .ToList();

    var expiredCount = orderedItems.Count(x => (x.Status?.Trim()) == "InspectionExpired");
    var returnedCount = orderedItems.Count(x => (x.Status?.Trim()) is "ReturnedToValuer" or "Resubmitted");
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.dataTables.min.css" />
<link href="~/css/valuer-inbox.css" rel="stylesheet" asp-append-version="true" />

<div class="vi-page">
    @if (TempData["Success"] != null)
    {
        <div class="vi-banner vi-banner-success">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="vi-banner vi-banner-danger">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" /><path d="M12 8v5M12 16h.01" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
            @TempData["Error"]
        </div>
    }

    <div class="vi-hero">
        <div class="vi-hero-icon">
            <i class="fa-solid fa-clipboard-check"></i>
        </div>
        <div class="vi-hero-text">
            <span class="vi-hero-eyebrow">@selfRoleLabel Workbench</span>
            <h1>My Reviews</h1>
            <p>Attribute submissions assigned to you for review and physical inspection follow-up.</p>
        </div>
        <div class="vi-hero-stats">
            <div class="vi-hero-stat">
                <span class="vi-hero-stat-num">@orderedItems.Count</span>
                <span class="vi-hero-stat-label">Assigned to you</span>
            </div>

            @if (returnedCount > 0)
            {
                <div class="vi-hero-stat vi-hero-stat-warn">
                    <span class="vi-hero-stat-num">@returnedCount</span>
                    <span class="vi-hero-stat-label">Needs your attention</span>
                </div>
            }
        </div>
    </div>

    @if (expiredCount > 0)
    {
        <div class="vi-urgent-alert">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <div>
                <strong>@expiredCount inspection request@(expiredCount == 1 ? "" : "s")</strong>
                expired without a client response.
                Send new inspection dates to keep @(expiredCount == 1 ? "it" : "them") moving.
            </div>
        </div>
    }

    @if (!orderedItems.Any())
    {
        <div class="vi-empty">
            <i class="fa-solid fa-mug-hot"></i>
            <h3>Nothing waiting on you right now</h3>
            <p>New assignments will appear here as soon as they're routed to you.</p>
        </div>
    }
    else
    {
        <div class="vi-toolbar">
            <div class="vi-chips">
                <button type="button" class="vi-chip active" data-filter-chip data-filter-status="">
                    All <span>(@orderedItems.Count)</span>
                </button>

                @foreach (var chip in statusChips)
                {
                    <button type="button" class="vi-chip" data-filter-chip data-filter-status="@chip.StatusKey">
                        <span class="vi-chip-dot" style="background:@StatusColor(chip.StatusKey);"></span>
                        @chip.Label <span>(@chip.Count)</span>
                    </button>
                }
            </div>
        </div>

        <div class="vi-card">
            <div class="vi-card-title">
                <div>My Assigned Reviews</div>
                <div class="vi-card-title-count"><span id="viVisibleCount">@orderedItems.Count</span> item(s)</div>
            </div>

            <div class="table-responsive">
                <table class="vi-table" id="viResultsTable">
                    <thead>
                        <tr>
                            <th>Reference No</th>
                            <th>Property Description</th>
                            <th>Township</th>
                            <th>Sector</th>
                            <th>Assigned Date</th>
                            <th>Evidence</th>
                            <th>Status</th>
                            <th>Assigned By</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in orderedItems)
                        {
                            <tr data-status="@item.Status">
                                <td class="vi-ref" style="box-shadow: inset 4px 0 0 @StatusColor(item.Status);">@item.AttrNo</td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(item.PropertyDescription))
                                    {
                                        <span class="vi-muted">-</span>
                                    }
                                    else
                                    {
                                        @item.PropertyDescription
                                    }
                                </td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(item.Township))
                                    {
                                        <span class="vi-muted">-</span>
                                    }
                                    else
                                    {
                                        @item.Township
                                    }
                                </td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(item.Sector))
                                    {
                                        <span class="vi-muted">-</span>
                                    }
                                    else
                                    {
                                        @item.Sector
                                    }
                                </td>

                                <td class="vi-muted" data-order="@(item.AssignedDate?.Ticks ?? 0)">
                                    @(item.AssignedDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")
                                </td>

                                <td>@item.EvidenceCount</td>

                                <td>
                                    <span class="vi-badge @StatusBadgeClass(item.Status)">
                                        <i class="fa-solid @StatusIcon(item.Status)"></i>
                                        @StatusText(item.Status)
                                    </span>
                                </td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(item.AssignedBy))
                                    {
                                        <span class="vi-muted">-</span>
                                    }
                                    else
                                    {
                                        @item.AssignedBy
                                    }
                                </td>

                                <td>
                                    <a class="vi-btn"
                                           asp-controller="ValuerInbox"
                                           asp-action="Review"
                                           asp-route-id="@item.AttrId">
                                        @ButtonText(item)
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script>
        (function () {
        var table = null;
        var activeStatus = '';

        $(function () {
        if ($('#viResultsTable').length && !$.fn.DataTable.isDataTable('#viResultsTable')) {
        table = $('#viResultsTable').DataTable({
        responsive: {
        breakpoints: [
        { name: 'desktop', width: Infinity },
        { name: 'phone', width: 640 }
        ]
        },
        dom: '<"vi-dt-top"lf>rt<"vi-dt-bottom"ip>',
        lengthMenu: [[10, 25, 50, -1], [10, 25, 50, 'All']],
        pageLength: 25,
        order: [],
        columnDefs: [
        { targets: 0, className: 'all' },
        { targets: -1, orderable: false, className: 'all' }
        ],
        language: {
        search: '_INPUT_',
        searchPlaceholder: 'Search reference, property, township…',
        emptyTable: 'No records match your filters.'
        },
        drawCallback: function () {
        var info = table.page.info();
        var el = document.getElementById('viVisibleCount');
        if (el) el.textContent = info.recordsDisplay;
        }
        });
        }

        var chips = document.querySelectorAll('[data-filter-chip]');

        chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
        chips.forEach(function (c) { c.classList.remove('active'); });
        chip.classList.add('active');
        activeStatus = chip.getAttribute('data-filter-status') || '';

        if (table) {
        // Status column shows the friendly label with an
        // icon, not the raw status key — filter on the
        // row's data-status attribute instead via a
        // custom search function scoped to this table.
        $.fn.dataTable.ext.search.pop();

        if (activeStatus) {
        $.fn.dataTable.ext.search.push(function (settings, data, rowIndex) {
        if (settings.nTable.id !== 'viResultsTable') return true;
        var row = table.row(rowIndex).node();
        return row && row.getAttribute('data-status') === activeStatus;
        });
        }

        table.draw();
        }
        });
        });
        });
        })();
    </script>
}
