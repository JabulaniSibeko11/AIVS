@model AIVS.Models.ViewModels.ValuerInbox.ValuerReviewPageVm
@using AIVS.Workflow
@using System.Globalization

@{
    ViewData["Title"] = "Review " + Model.AttrNo;

    string SectionLabel(string? code) => (code ?? "").ToUpperInvariant() switch
    {
        "PROPERTY_DETAILS" => "Property Details",
        "VALUATION_DETAILS" => "Valuation Details",
        "CONTACT_INFORMATION" => "Contact Information",
        "PRIMARY_ATTRIBUTES" => "Primary Attributes",
        "SECONDARY_ATTRIBUTES" => "Secondary Attributes",
        "BUSINESS_BUILDINGS" => "Business Buildings",
        "BUSINESS_SECTIONS" => "Business Sections",
        "BUSINESS_GENERAL" => "Business General",
        "DRC_BUILDINGS" => "DRC Buildings",
        "DRC_IMPROVEMENTS" => "DRC Improvements",
        "DRC_VACANT_LAND" => "DRC Vacant Land",
        "ADDITIONAL_COMMENTS" => "Additional Comments",
        "DECLARATION" => "Declaration",
        var s when string.IsNullOrWhiteSpace(s) => "Section",
        var s => s
    };

    string SectionDotColor(AIVS.Models.ViewModels.ValuerInbox.ValuerReviewSectionVm section) => (section.SectionDecision?.Trim()) switch
    {
        "Accepted" => "var(--aivs-success)",
        "Needs correction" => "var(--aivs-danger)",
        "Requires inspection" => "var(--aivs-gold-dark)",
        "Not applicable" => "var(--aivs-grey)",
        _ => "transparent"
    };

    var sections = Model.Sections ?? new List<AIVS.Models.ViewModels.ValuerInbox.ValuerReviewSectionVm>();
    var progressPct = Model.TotalSections == 0 ? 0 : (double)Model.ReviewedSections / Model.TotalSections * 100;
}

<link href="~/css/review-page.css" rel="stylesheet" asp-append-version="true" />

<div class="rv-page">

    <div class="rv-actions">
        <a class="rv-btn-back"
               asp-controller="ValuerInbox"
               asp-action="Index">
            Back to Review Inbox
        </a>

        <div class="rv-top-badges">
            <span class="rv-badge">
                Review Status: @AttributeWorkflowStatus.Display(Model.ReviewStatus)
            </span>

            <span class="rv-badge rv-badge-dark">
                @Model.AttrNo
            </span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="rv-alert rv-alert-success">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="rv-alert rv-alert-danger">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" /><path d="M12 8v5M12 16h.01" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
            @TempData["Error"]
        </div>
    }

    @if (Model.IsLockedByAnotherUser)
    {
        <div class="rv-alert rv-alert-danger">This review is currently being edited by @Model.LockedByName until @Model.LockExpiresAt?.ToString("HH:mm"). The page is read-only.</div>
    }

    <div class="rv-header">
        <div class="rv-title-row">
            <div>
                <h1 class="rv-title">Review: @Model.AttrNo</h1>

                <div class="rv-subtitle">
                    Review the submitted attribute form section by section. Record a decision and comment, then choose the appropriate final action.
                </div>
            </div>

            <span class="rv-badge">
                @Display(Model.FormType)
            </span>
        </div>

        <div class="rv-progress-track">
            <div class="rv-progress-fill" style="width:@(progressPct.ToString("0.###", CultureInfo.InvariantCulture))%;"></div>
        </div>
        <div class="rv-progress-label">@Model.ReviewedSections of @Model.TotalSections sections reviewed</div>

        <div class="rv-grid">
            <div class="rv-box">
                <div class="rv-label">Sector</div>
                <div class="rv-value">@Display(Model.Sector)</div>
            </div>

            <div class="rv-box">
                <div class="rv-label">Status</div>
                <div class="rv-value">@FriendlyStatus(Model.Status)</div>
            </div>

            <div class="rv-box">
                <div class="rv-label">Form Type</div>
                <div class="rv-value">@Display(Model.FormType)</div>
            </div>

            <div class="rv-box rv-box-evidence">
                <div class="rv-label">Client Evidence</div>
                <div class="rv-value">@Model.EvidenceCount file(s)</div>
            </div>

            <div class="rv-box">
                <div class="rv-label">Review Started</div>
                <div class="rv-value">@Model.StartedAt.ToString("yyyy-MM-dd HH:mm")</div>
            </div>
        </div>
    </div>

    @if (Model.EvidenceFiles != null && Model.EvidenceFiles.Any())
    {
        <a class="rv-evidence-attention" href="#uploaded-evidence">
            <span class="rv-evidence-attention-icon"><i class="fa-solid fa-paperclip"></i></span>
            <span class="rv-evidence-attention-copy">
                <strong>Client evidence requires your attention</strong>
                <span>@Model.EvidenceFiles.Count file(s) were submitted with this attribute request. Review the evidence before completing the assessment.</span>
            </span>
            <span class="rv-evidence-attention-action">Review evidence <i class="fa-solid fa-arrow-right"></i></span>
        </a>
    }

    <section class="rv-evidence-panel" id="uploaded-evidence">
        <div class="rv-evidence-panel-head">
            <div>
                <div class="rv-evidence-panel-title"><i class="fa-solid fa-paperclip"></i> Client Uploaded Evidence</div>
                <div class="rv-evidence-panel-subtitle">Open each supporting document before completing the attribute assessment.</div>
            </div>
            @if (Model.EvidenceFiles != null && Model.EvidenceFiles.Any())
            {
                <a class="rv-evidence-zip" asp-controller="ValuerInbox" asp-action="DownloadEvidenceZip" asp-route-attrId="@Model.AttrId" asp-route-kind="client">
                    <i class="fa-solid fa-file-zipper"></i> Download All
                </a>
            }
        </div>

        @if (Model.EvidenceFiles == null || !Model.EvidenceFiles.Any())
        {
            <div class="rv-evidence-empty">No client evidence files were found for this submission.</div>
        }
        else
        {
            <div class="rv-evidence-grid">
                @foreach (var file in Model.EvidenceFiles)
                {
                    <article class="rv-evidence-file-card">
                        <div class="rv-evidence-file-icon">
                            <i class="@(string.Equals(file.FileType, "application/pdf", StringComparison.OrdinalIgnoreCase) ? "fa-solid fa-file-pdf" : "fa-solid fa-file-image")"></i>
                        </div>
                        <div class="rv-evidence-file-info">
                            <div class="rv-evidence-file-name" title="@file.FileName">@Display(file.FileName)</div>
                            <div class="rv-evidence-file-meta">
                                @(file.UploadedDateTime?.ToString("dd MMM yyyy HH:mm") ?? "Date unavailable")
                                @if (file.FileSize.HasValue)
                                {
                                    <span> · @((file.FileSize.Value / 1024.0).ToString("N0")) KB</span>
                                }
                            </div>
                        </div>
                        <div class="rv-evidence-file-actions">
                            <a class="rv-evidence-view"
                                   asp-controller="ValuerInbox"
                                   asp-action="ClientEvidenceFile"
                                   asp-route-attrId="@Model.AttrId"
                                   asp-route-evidenceKey="@file.EvidenceKey"
                                   asp-route-download="false"
                                   target="_blank" rel="noopener">
                                <i class="fa-solid fa-eye"></i> View
                            </a>
                            <a class="rv-evidence-download"
                                   asp-controller="ValuerInbox"
                                   asp-action="ClientEvidenceFile"
                                   asp-route-attrId="@Model.AttrId"
                                   asp-route-evidenceKey="@file.EvidenceKey"
                                   asp-route-download="true">
                                <i class="fa-solid fa-download"></i> Download
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="rv-evidence-panel" id="inspection-evidence">
        <div class="rv-evidence-panel-head">
            <div>
                <div class="rv-evidence-panel-title"><i class="fa-solid fa-camera"></i> Inspection Evidence</div>
                <div class="rv-evidence-panel-subtitle">Evidence uploaded by the Valuer or Sector Manager during the physical inspection is shown here and forms part of the review record.</div>
            </div>
        </div>

        @if (Model.PhysicalInspectionEvidenceFiles == null || !Model.PhysicalInspectionEvidenceFiles.Any())
        {
            <div class="rv-evidence-empty">No inspection evidence has been uploaded from Genesis yet.</div>
        }
        else
        {
            <div class="rv-evidence-grid">
                @foreach (var file in Model.PhysicalInspectionEvidenceFiles)
                {
                    <article class="rv-evidence-file-card">
                        <div class="rv-evidence-file-icon">
                            <i class="@(file.IsImage ? "fa-solid fa-file-image" : "fa-solid fa-file")"></i>
                        </div>
                        <div class="rv-evidence-file-info">
                            <div class="rv-evidence-file-name" title="@file.FileName">@Display(file.FileName)</div>
                            <div class="rv-evidence-file-meta">
                                @file.UploadedAt.ToString("dd MMM yyyy HH:mm")
                                <span> · @(file.UploadedByName ?? file.UploadedBySapNumber ?? "Valuer / Sector Manager")</span>
                                <span> · @file.FileSizeDisplay</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(file.EvidenceComment))
                            {
                                <div class="rv-block-note" style="margin-top:8px;">
                                    <strong>Inspection note:</strong> @Display(file.EvidenceComment)
                                </div>
                            }
                        </div>
                        <div class="rv-evidence-file-actions">
                            <a class="rv-evidence-view"
                                   asp-controller="ValuerInbox"
                                   asp-action="PhysicalInspectionEvidenceFile"
                                   asp-route-id="@file.Id"
                                   target="_blank" rel="noopener">
                                <i class="fa-solid fa-eye"></i> View
                            </a>
                            <a class="rv-evidence-download"
                                   asp-controller="ValuerInbox"
                                   asp-action="PhysicalInspectionEvidenceFile"
                                   asp-route-id="@file.Id"
                                   asp-route-download="true">
                                <i class="fa-solid fa-download"></i> Download
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <div class="rv-section-title">
        City Record Compared with Client Submission
    </div>

    @await Html.PartialAsync("_AttributeComparison", Model)

    <div class="rv-review-layout rv-legacy-review-layout">
        <main class="rv-main">
            @if (Model.SubmittedForm != null)
            {
                @await Html.PartialAsync("_SubmittedAttributeFormReadOnly", Model)
            }
            else
            {
                <div class="rv-warning">
                    Submitted form values could not be loaded.
                </div>
            }

            @if (Model.Sections == null || !Model.Sections.Any())
            {
                <div class="rv-warning">
                    No review sections were created for this submission.
                </div>
            }
        </main>

        <aside class="rv-side">
            @if (sections.Any())
            {
                <div class="rv-side-card">
                    <div class="rv-side-head">
                        Section <span>Navigator</span>
                    </div>

                    <div class="rv-side-body">
                        <div class="rv-nav-list">
                            @foreach (var sec in sections)
                            {
                                <a class="rv-nav-link" data-nav-target="sec-@sec.SectionCode" href="#sec-@sec.SectionCode">
                                    <span class="rv-nav-dot" style="background:@SectionDotColor(sec); border-color:@SectionDotColor(sec);"></span>
                                    @SectionLabel(sec.SectionCode)
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="rv-side-card">
                <div class="rv-side-head">
                    Review <span>Progress</span>
                </div>

                <div class="rv-side-body">
                    <div class="rv-side-stat">
                        <span>Total Sections</span>
                        <span>@Model.TotalSections</span>
                    </div>

                    <div class="rv-side-stat">
                        <span>Reviewed</span>
                        <span class="rv-stat-good">@Model.ReviewedSections</span>
                    </div>

                    <div class="rv-side-stat">
                        <span>Corrections</span>
                        <span class="@(Model.CorrectionSections > 0 ? "rv-stat-danger" : "rv-stat-good")">@Model.CorrectionSections</span>
                    </div>

                    <div class="rv-side-stat">
                        <span>Inspections</span>
                        <span class="@(Model.InspectionSections > 0 ? "rv-stat-warn" : "rv-stat-good")">@Model.InspectionSections</span>
                    </div>
                </div>
            </div>

            <div class="rv-side-card rv-legacy-final-decision">
                <div class="rv-side-head">
                    Final <span>Decision</span>
                </div>
                <div class="rv-side-body">
                    @if (string.Equals(Model.Status, "ReadyForOvvioExtract", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="rv-ok-note">
                            <strong>Accepted / Ready for OVVIO Extract.</strong><br />
                            This submission has been finalised by the valuer and is waiting for OVVIO extraction.
                        </div>
                    }
                    else if (Model.CanSubmitToOvvio)
                    {
                        <div class="rv-ok-note">
                            Required sections are clear. This review can be submitted to OVVIO.
                        </div>
                    }
                    else
                    {
                        <div class="rv-block-note">
                            Submit to OVVIO is blocked: @Display(Model.SubmitBlockReason)
                        </div>
                    }


                    <form asp-controller="ValuerInbox"
                          asp-action="SubmitFinalReview"
                          method="post"
                          id="finalReviewForm">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="AttrId" value="@Model.AttrId" />
                        <input type="hidden" name="ReviewId" value="@Model.ReviewId" />
                        <input type="hidden" name="FinalDecision" id="finalDecisionValue" />

                        <label class="fw-bold mb-1" style="font-size:13px;">Final Comment</label>

                        <textarea name="FinalComment"
                                  class="rv-final-textarea"
                                  placeholder="Enter final review comment..."
                                  required>@Model.FinalComment</textarea>

                        <div class="rv-small-text mt-2">
                            Submit to OVVIO is only available when required review sections have no corrections or inspection requirement.
                        </div>

                        <button type="submit"
                                class="rv-final-btn rv-final-btn-ovvio"
                                onclick="return setFinalDecision('SubmitToOvvio');"
                                disabled="@(!Model.CanSubmitToOvvio || string.Equals(Model.Status, "ReadyForOvvioExtract", StringComparison.OrdinalIgnoreCase))">
                            Submit to OVVIO
                        </button>

                        <button type="submit"
                                class="rv-final-btn rv-final-btn-return"
                                onclick="return setFinalDecision('ReturnToClient');"
                                disabled="@(string.Equals(Model.Status, "ReadyForOvvioExtract", StringComparison.OrdinalIgnoreCase))">
                            Return to Client for Update
                        </button>
                       
                    </form>
                </div>
            </div>

            <div class="rv-side-card">
                <div class="rv-side-head">
                    Reviewed <span>PDF</span>
                </div>

                <div class="rv-side-body">
                    @if (!string.IsNullOrWhiteSpace(Model.ValuerEvidencePath))
                    {
                        <div class="rv-ok-note">
                            Reviewed form PDF has been generated.
                        </div>

                        <a class="rv-final-btn rv-final-btn-ovvio"
                               href="@Url.Action("ReviewedPdf", "ValuerInbox", new { attrId = Model.AttrId })"
                               target="_blank">
                            Open Reviewed PDF
                        </a>
                    }
                    else
                    {
                        <div class="rv-block-note">
                            Reviewed PDF will be generated after the final review decision is submitted.
                        </div>
                    }
                </div>
            </div>
            <div class="rv-side-card">
                <div class="rv-side-head">
                    Physical <span>Inspection</span>
                </div>

                <div class="rv-side-body">
                    @if (Model.ActiveInspectionRequest != null)
                    {
                        <div class="rv-block-note">
                            Inspection request status: @AttributeWorkflowStatus.Display(Model.ActiveInspectionRequest.Status)
                        </div>

                        @foreach (var slot in Model.ActiveInspectionRequest.Slots)
                        {
                            <div class="rv-evidence-item">
                                <div class="rv-evidence-name">
                                    Option @slot.SlotNo
                                </div>

                                <div class="rv-evidence-meta">
                                    @slot.ProposedDateTime.ToString("yyyy-MM-dd HH:mm")
                                    &middot;
                                    @AttributeWorkflowStatus.Display(slot.SlotStatus)
                                </div>
                            </div>
                        }

                        @if (string.Equals(Model.ActiveInspectionRequest.Status, "Expired", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="rv-block-note">
                                The client did not select any of the proposed inspection dates before they expired.
                                You may send a new set of three inspection date options.
                            </div>

                            <button type="button"
                                    class="rv-final-btn rv-final-btn-inspection"
                                    onclick="openInspectionModal();">
                                Send New Inspection Date Options
                            </button>
                        }
                        else if (string.Equals(Model.ActiveInspectionRequest.Status, "Confirmed", StringComparison.OrdinalIgnoreCase))
                        {
                            @if (Model.ActiveInspectionRequest.ValuerDetailsSent)
                            {
                                <div class="rv-ok-note">
                                    Inspection details sent to client on
                                    @Model.ActiveInspectionRequest.ValuerDetailsSentAt?.ToString("yyyy-MM-dd HH:mm").
                                    PIN: @Model.ActiveInspectionRequest.InspectionPin
                                </div>
                            }
                            else
                            {
                                <form asp-controller="ValuerInbox"
                                      asp-action="SendInspectionDetails"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="inspectionRequestId"
                                           value="@Model.ActiveInspectionRequest.Id" />

                                    <input type="hidden"
                                           name="attrId"
                                           value="@Model.AttrId" />

                                    <button type="submit"
                                            class="rv-final-btn rv-final-btn-inspection"
                                            onclick="return confirm('Generate inspection PIN and prepare valuer details for the client?');">
                                        Send Valuer Details &amp; PIN to Client
                                    </button>
                                </form>
                            }
                        }

                        @if (Model.ActiveInspectionRequest.ConfirmedDateTime != null)
                        {
                            <div class="rv-ok-note">
                                Confirmed: @Model.ActiveInspectionRequest.ConfirmedDateTime.Value.ToString("yyyy-MM-dd HH:mm")
                            </div>
                        }

                        @if (Model.InspectionCompleted || string.Equals(Model.ActiveInspectionRequest.Status, "Completed", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="rv-ok-note" style="margin-top:10px;">
                                <strong>Physical inspection completed.</strong><br />
                                @Model.PhysicalInspectionEvidenceCount inspection evidence file(s) are attached to this review.
                                The Processor can now complete the review and submit it to the QA / OVVIO workflow.
                            </div>
                        }
                        else if (Model.CanCompleteInspection)
                        {
                            <form asp-controller="ValuerInbox"
                                  asp-action="CompleteInspection"
                                  method="post"
                                  style="margin-top:10px;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="inspectionRequestId" value="@Model.ActiveInspectionRequest.Id" />
                                <input type="hidden" name="attrId" value="@Model.AttrId" />
                                <button type="submit"
                                        class="rv-final-btn rv-final-btn-ovvio"
                                        onclick="return confirm('Close this physical inspection? The evidence already received from Genesis will remain attached to the review.');">
                                    Close Physical Inspection
                                </button>
                            </form>
                        }
                        else if (!string.IsNullOrWhiteSpace(Model.InspectionCompletionBlockReason))
                        {
                            <div class="rv-block-note" style="margin-top:10px;">
                                @Model.InspectionCompletionBlockReason
                            </div>
                        }
                    }
                    else
                    {
                        <div class="rv-small-text mb-2">
                            Internal Processor Evidence must be uploaded before a physical inspection can be requested.
                        </div>
                        <button type="button"
                                class="rv-final-btn rv-final-btn-inspection"
                                onclick="openInspectionModal();">
                            Request Physical Inspection
                        </button>
                    }
                </div>
            </div>
        </aside>
    </div>
</div>

<div id="inspectionModal" class="insp-modal-backdrop" style="display:none;">
    <div class="insp-modal">
        <div class="insp-modal-head">
            <div>Request Physical Inspection</div>
            <button type="button" onclick="closeInspectionModal()">&times;</button>
        </div>

        <form asp-controller="ValuerInbox"
              asp-action="ScheduleInspection"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" name="AttrId" value="@Model.AttrId" />
            <input type="hidden" name="ReviewId" value="@Model.ReviewId" />

            <div class="insp-modal-body">
                <label>Option 1</label>
                <input type="datetime-local" name="Option1" class="insp-input" required />

                <label>Option 2</label>
                <input type="datetime-local" name="Option2" class="insp-input" required />

                <label>Option 3</label>
                <input type="datetime-local" name="Option3" class="insp-input" required />

                <label>Comment to Client</label>
                <textarea name="RequestComment"
                          class="insp-textarea"
                          placeholder="Enter inspection request note for the client..."></textarea>
            </div>

            <div class="insp-modal-footer">
                <button type="button" class="insp-btn-cancel" onclick="closeInspectionModal()">Cancel</button>
                <button type="submit" class="insp-btn-submit">Send Inspection Request</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function setFinalDecision(decision) {
            const comment = document.querySelector('textarea[name="FinalComment"]');

            if (!comment || !comment.value.trim()) {
                alert('Please enter a final comment before submitting.');
                return false;
            }

            const hidden = document.getElementById('finalDecisionValue');

            if (!hidden) {
                alert('Final decision field was not found.');
                return false;
            }

            hidden.value = decision;

            var confirmed = false;

                        if (decision === 'SubmitToOvvio') {
                confirmed = confirm('Submit this review to OVVIO extract?');
            } else if (decision === 'ReturnToClient') {
                confirmed = confirm('Return this submission to the client for update?');
            }

            if (confirmed && window.aivsClearAllDirty) window.aivsClearAllDirty();

            return confirmed;
        }

        function openInspectionModal() {
            document.getElementById('inspectionModal').style.display = 'flex';
        }

        function closeInspectionModal() {
            document.getElementById('inspectionModal').style.display = 'none';
        }

        // ---- Unsaved-section tracking, shared with _SectionReviewPanel partials ----
        (function () {
            var dirtySections = new Set();

            window.aivsRegisterDirty = function (code) { dirtySections.add(code); };
            window.aivsClearDirty = function (code) { dirtySections.delete(code); };
            window.aivsClearAllDirty = function () { dirtySections.clear(); };

            window.addEventListener('beforeunload', function (e) {
                if (dirtySections.size === 0) return;
                e.preventDefault();
                e.returnValue = '';
            });
        })();

        // ---- Section navigator: scroll-spy active state ----
        (function () {
            var links = Array.from(document.querySelectorAll('.rv-nav-link'));
            if (!links.length) return;

            var targets = links
                .map(function (link) {
                    var el = document.getElementById(link.getAttribute('data-nav-target'));
                    return el ? { link: link, el: el } : null;
                })
                .filter(Boolean);

            if (!targets.length) return;

            var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    var match = targets.find(function (t) { return t.el === entry.target; });
                    if (match) match.link.classList.toggle('is-active', entry.isIntersecting);
                });
            }, { rootMargin: '-80px 0px -70% 0px', threshold: 0 });

            targets.forEach(function (t) { observer.observe(t.el); });
        })();
    </script>
}

@functions {
    private Microsoft.AspNetCore.Html.IHtmlContent Display(object? value)
    {
        var text = value?.ToString();

        if (string.IsNullOrWhiteSpace(text))
        {
            return new Microsoft.AspNetCore.Html.HtmlString("-");
        }

        return new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(text));
    }
    private string FriendlyStatus(string? status)
    {
        return AttributeWorkflowStatus.Display(status);
    }
}