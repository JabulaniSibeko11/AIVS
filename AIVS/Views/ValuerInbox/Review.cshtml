@model AIVS.Models.ViewModels.ValuerInbox.ValuerReviewPageVm

@{
    ViewData["Title"] = "Review " + Model.AttrNo;
}

<style>
    .rv-page {
        padding-bottom: 35px;
    }

    .rv-actions {
        position: sticky;
        top: 0;
        z-index: 50;
        background: #f5f6f8;
        border-bottom: 1px solid #e0e0e0;
        padding: 10px 0;
        margin-bottom: 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .rv-btn-back {
        background: #000000;
        color: #ffffff;
        border-radius: 7px;
        padding: 9px 15px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 900;
        display: inline-block;
    }

        .rv-btn-back:hover {
            background: #e6b000;
            color: #000000;
        }

    .rv-top-badges {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .rv-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 999px;
        background: #fff0bf;
        color: #5a4100;
        font-size: 12px;
        font-weight: 900;
    }

    .rv-badge-dark {
        background: #111111;
        color: #ffffff;
    }

    .rv-header {
        background: #ffffff;
        border: 1px solid #e3e3e3;
        border-left: 6px solid #e6b000;
        border-radius: 10px;
        padding: 20px 22px;
        margin-bottom: 20px;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
    }

    .rv-title-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
        flex-wrap: wrap;
    }

    .rv-title {
        margin: 0;
        font-weight: 900;
        color: #111111;
        font-size: 28px;
        line-height: 1.2;
    }

    .rv-subtitle {
        margin-top: 6px;
        color: #666666;
        font-size: 14px;
        font-weight: 600;
    }

    .rv-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 12px;
        margin-top: 16px;
    }

    .rv-box {
        background: #f8f8f8;
        border: 1px solid #e2e2e2;
        border-radius: 9px;
        padding: 12px;
    }

    .rv-label {
        font-size: 12px;
        text-transform: uppercase;
        color: #666666;
        font-weight: 900;
        letter-spacing: .2px;
    }

    .rv-value {
        margin-top: 5px;
        color: #111111;
        font-weight: 900;
        word-break: break-word;
    }

    .rv-section-title {
        margin: 24px 0 13px;
        font-size: 21px;
        font-weight: 900;
        color: #111111;
        border-left: 5px solid #e6b000;
        padding-left: 12px;
    }

    .rv-warning {
        background: #fff6d6;
        border: 1px solid #ead17a;
        border-left: 5px solid #e6b000;
        color: #4a3900;
        border-radius: 8px;
        padding: 14px 16px;
        font-weight: 800;
        margin-bottom: 18px;
    }

    .rv-alert {
        border-radius: 8px;
        padding: 12px 14px;
        margin-bottom: 14px;
        font-weight: 900;
    }

    .rv-alert-success {
        background: #e8f7ee;
        border: 1px solid #b9e5c8;
        color: #155724;
    }

    .rv-alert-danger {
        background: #fdecec;
        border: 1px solid #f4bcbc;
        color: #842029;
    }

    .rv-review-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 360px;
        gap: 18px;
        align-items: start;
    }

    .rv-main {
        min-width: 0;
    }

    .rv-side {
        position: sticky;
        top: 72px;
    }

    .rv-side-card {
        background: #ffffff;
        border: 1px solid #dedede;
        border-radius: 10px;
        margin-bottom: 14px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
    }

    .rv-side-head {
        background: #111111;
        color: #ffffff;
        padding: 12px 14px;
        font-weight: 900;
    }

        .rv-side-head span {
            color: #e6b000;
        }

    .rv-side-body {
        padding: 14px;
    }

    .rv-side-stat {
        display: flex;
        justify-content: space-between;
        border-bottom: 1px solid #eeeeee;
        padding: 8px 0;
        font-weight: 800;
        gap: 12px;
    }

        .rv-side-stat:last-child {
            border-bottom: 0;
        }

    .rv-stat-good {
        color: #198754;
    }

    .rv-stat-warn {
        color: #b38300;
    }

    .rv-stat-danger {
        color: #dc3545;
    }

    .rv-final-textarea {
        width: 100%;
        min-height: 120px;
        border: 1px solid #cfcfcf;
        border-radius: 8px;
        padding: 10px;
        font-weight: 600;
        resize: vertical;
    }

    .rv-final-btn {
        width: 100%;
        border: 0;
        border-radius: 8px;
        padding: 10px 12px;
        margin-top: 9px;
        font-size: 13px;
        font-weight: 900;
        cursor: pointer;
    }

    .rv-final-btn-ovvio {
        background: #198754;
        color: #ffffff;
    }

    .rv-final-btn-return {
        background: #e6b000;
        color: #000000;
    }

    .rv-final-btn-inspection {
        background: #0d6efd;
        color: #ffffff;
    }

    .rv-final-btn-reject {
        background: #dc3545;
        color: #ffffff;
    }

    .rv-final-btn:hover {
        filter: brightness(.94);
    }

    .rv-final-btn:disabled {
        background: #bdbdbd;
        color: #555555;
        cursor: not-allowed;
        filter: none;
    }

    .rv-block-note {
        background: #fff6d6;
        border: 1px solid #ead17a;
        border-left: 4px solid #e6b000;
        border-radius: 8px;
        padding: 10px;
        font-size: 13px;
        font-weight: 800;
        color: #4a3900;
        margin-bottom: 12px;
    }

    .rv-ok-note {
        background: #e8f7ee;
        border: 1px solid #b9e5c8;
        border-left: 4px solid #198754;
        border-radius: 8px;
        padding: 10px;
        font-size: 13px;
        font-weight: 800;
        color: #155724;
        margin-bottom: 12px;
    }

    .rv-evidence-item {
        border: 1px solid #eeeeee;
        border-radius: 8px;
        padding: 9px;
        margin-bottom: 8px;
        background: #f9f9f9;
    }

    .rv-evidence-name {
        font-weight: 900;
        color: #111111;
        word-break: break-word;
    }

    .rv-evidence-meta {
        font-size: 12px;
        color: #666666;
        margin-top: 3px;
    }

    .rv-evidence-link {
        display: inline-block;
        margin-top: 6px;
        color: #000000;
        font-weight: 900;
        font-size: 12px;
        text-decoration: underline;
    }

    .rv-small-text {
        font-size: 12px;
        color: #666666;
        font-weight: 700;
        line-height: 1.4;
    }

    .insp-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 2000;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .insp-modal {
        width: min(620px, 94vw);
        background: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 18px 40px rgba(0,0,0,.25);
    }

    .insp-modal-head {
        background: #111111;
        color: #ffffff;
        padding: 14px 18px;
        font-weight: 900;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .insp-modal-head button {
            background: transparent;
            border: 0;
            color: #ffffff;
            font-size: 24px;
            font-weight: 900;
            cursor: pointer;
        }

    .insp-modal-body {
        padding: 18px;
        display: grid;
        gap: 10px;
    }

        .insp-modal-body label {
            font-weight: 900;
            color: #111111;
        }

    .insp-input,
    .insp-textarea {
        width: 100%;
        border: 1px solid #cfcfcf;
        border-radius: 8px;
        padding: 10px;
        font-weight: 700;
    }

    .insp-textarea {
        min-height: 100px;
    }

    .insp-modal-footer {
        padding: 14px 18px;
        border-top: 1px solid #eeeeee;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .insp-btn-cancel {
        background: #f1f1f1;
        color: #111111;
        border: 1px solid #d0d0d0;
        border-radius: 8px;
        padding: 9px 14px;
        font-weight: 900;
    }

    .insp-btn-submit {
        background: #e6b000;
        color: #000000;
        border: 0;
        border-radius: 8px;
        padding: 9px 14px;
        font-weight: 900;
    }

    @@media (max-width: 1100px) {
        .rv-review-layout {
            grid-template-columns: 1fr;
        }

        .rv-side {
            position: static;
        }
    }
</style>

<div class="rv-page">

    <div class="rv-actions">
        <a class="rv-btn-back"
               asp-controller="ValuerInbox"
               asp-action="Index">
            Back to Valuer Inbox
        </a>

        <div class="rv-top-badges">
            <span class="rv-badge">
                Review Status: @(string.IsNullOrWhiteSpace(Model.ReviewStatus) ? "In Progress" : Model.ReviewStatus)
            </span>

            <span class="rv-badge rv-badge-dark">
                @Model.AttrNo
            </span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="rv-alert rv-alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="rv-alert rv-alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="rv-header">
        <div class="rv-title-row">
            <div>
                <h1 class="rv-title">Review: @Model.AttrNo</h1>

                <div class="rv-subtitle">
                    Review the submitted Genesis attribute form. Each section has its own decision, correction flag, inspection flag, and valuer comment.
                </div>
            </div>

            <span class="rv-badge">
                @Display(Model.FormType)
            </span>
        </div>

        <div class="rv-grid">
            <div class="rv-box">
                <div class="rv-label">Property Description</div>
                <div class="rv-value">@Display(Model.PropertyDescription)</div>
            </div>

            <div class="rv-box">
                <div class="rv-label">Township</div>
                <div class="rv-value">@Display(Model.Township)</div>
            </div>

            <div class="rv-box">
                <div class="rv-label">Sector</div>
                <div class="rv-value">@Display(Model.Sector)</div>
            </div>

            <div class="rv-box">
                <div class="rv-label">Status</div>
                <div class="rv-value">@Display(Model.Status)</div>
            </div>

            <div class="rv-box">
                <div class="rv-label">Form Type</div>
                <div class="rv-value">@Display(Model.FormType)</div>
            </div>

            <div class="rv-box">
                <div class="rv-label">Evidence Count</div>
                <div class="rv-value">@Model.EvidenceCount</div>
            </div>

            <div class="rv-box">
                <div class="rv-label">Review Started</div>
                <div class="rv-value">@Model.StartedAt.ToString("yyyy-MM-dd HH:mm")</div>
            </div>

            <div class="rv-box">
                <div class="rv-label">Review ID</div>
                <div class="rv-value">@Model.ReviewId</div>
            </div>
        </div>
    </div>

    <div class="rv-section-title">
        Submitted Genesis Form & Section Review
    </div>

    <div class="rv-review-layout">
        <main class="rv-main">
            @if (Model.SubmittedForm != null)
            {
                @await Html.PartialAsync("_SubmittedAttributeFormReadOnly", Model)
            }
            else
            {
                <div class="rv-warning">
                    Submitted form values could not be loaded.
                </div>
            }

            @if (Model.Sections == null || !Model.Sections.Any())
            {
                <div class="rv-warning">
                    No review sections were created for this submission.
                </div>
            }
        </main>

        <aside class="rv-side">
            <div class="rv-side-card">
                <div class="rv-side-head">
                    Review <span>Progress</span>
                </div>

                <div class="rv-side-body">
                    <div class="rv-side-stat">
                        <span>Total Sections</span>
                        <span>@Model.TotalSections</span>
                    </div>

                    <div class="rv-side-stat">
                        <span>Reviewed</span>
                        <span class="rv-stat-good">@Model.ReviewedSections</span>
                    </div>

                    <div class="rv-side-stat">
                        <span>Corrections</span>
                        <span class="@(Model.CorrectionSections > 0 ? "rv-stat-danger" : "rv-stat-good")">@Model.CorrectionSections</span>
                    </div>

                    <div class="rv-side-stat">
                        <span>Inspections</span>
                        <span class="@(Model.InspectionSections > 0 ? "rv-stat-warn" : "rv-stat-good")">@Model.InspectionSections</span>
                    </div>
                </div>
            </div>

            <div class="rv-side-card">
                <div class="rv-side-head">
                    Uploaded <span>Evidence</span>
                </div>

                <div class="rv-side-body">
                    @if (Model.EvidenceFiles == null || !Model.EvidenceFiles.Any())
                    {
                        <div class="rv-block-note">
                            No evidence files uploaded.
                        </div>
                    }
                    else
                    {
                        @foreach (var file in Model.EvidenceFiles)
                        {
                            <div class="rv-evidence-item">
                                <div class="rv-evidence-name">@Display(file.FileName)</div>

                                <div class="rv-evidence-meta">
                                    @Display(file.FileType)
                                    ·
                                    @(file.UploadedDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")
                                </div>

                                @if (!string.IsNullOrWhiteSpace(file.FilePath))
                                {
                                    <a class="rv-evidence-link"
                                           href="@file.FilePath"
                                           target="_blank">
                                        Open Evidence
                                    </a>
                                }
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="rv-side-card">
                <div class="rv-side-head">
                    Final <span>Decision</span>
                </div>

                <div class="rv-side-body">
                    @if (Model.CanSubmitToOvvio)
                    {
                        <div class="rv-ok-note">
                            Required sections are clear. This review can be submitted to OVVIO.
                        </div>
                    }
                    else
                    {
                        <div class="rv-block-note">
                            Submit to OVVIO is blocked: @Display(Model.SubmitBlockReason)
                        </div>
                    }

                    <form asp-controller="ValuerInbox"
                          asp-action="SubmitFinalReview"
                          method="post"
                          id="finalReviewForm">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="AttrId" value="@Model.AttrId" />
                        <input type="hidden" name="ReviewId" value="@Model.ReviewId" />
                        <input type="hidden" name="FinalDecision" id="finalDecisionValue" />

                        <label class="fw-bold mb-1">Final Comment</label>

                        <textarea name="FinalComment"
                                  class="rv-final-textarea"
                                  placeholder="Enter final review comment..."
                                  required>@Model.FinalComment</textarea>

                        <div class="rv-small-text mt-2">
                            Submit to OVVIO is only available when required review sections have no corrections or inspection requirement.
                        </div>

                        <button type="submit"
                                class="rv-final-btn rv-final-btn-ovvio"
                                onclick="return setFinalDecision('SubmitToOvvio');"
                                disabled="@(!Model.CanSubmitToOvvio)">
                            Submit to OVVIO
                        </button>

                        <button type="submit"
                                class="rv-final-btn rv-final-btn-return"
                                onclick="return setFinalDecision('ReturnToClient');">
                            Return to Client
                        </button>

                        <button type="submit"
                                class="rv-final-btn rv-final-btn-reject"
                                onclick="return setFinalDecision('Reject');">
                            Reject
                        </button>
                    </form>
                </div>
            </div>

            <div class="rv-side-card">
                <div class="rv-side-head">
                    Physical <span>Inspection</span>
                </div>

                <div class="rv-side-body">
                    @if (Model.ActiveInspectionRequest != null)
                    {
                        <div class="rv-block-note">
                            Inspection request status: @Model.ActiveInspectionRequest.Status
                        </div>

                        @foreach (var slot in Model.ActiveInspectionRequest.Slots)
                        {
                            <div class="rv-evidence-item">
                                <div class="rv-evidence-name">
                                    Option @slot.SlotNo
                                </div>

                                <div class="rv-evidence-meta">
                                    @slot.ProposedDateTime.ToString("yyyy-MM-dd HH:mm")
                                    ·
                                    @slot.SlotStatus
                                </div>
                            </div>
                        }
                        @if (string.Equals(Model.ActiveInspectionRequest.Status, "Expired", StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="rv-block-note">
                                The client did not select any of the proposed inspection dates before they expired.
                                You may send a new set of three inspection date options.
                            </div>

                            <button type="button"
                                    class="rv-final-btn rv-final-btn-inspection"
                                    onclick="openInspectionModal();">
                                Send New Inspection Date Options
                            </button>
                        }
                        else if (string.Equals(Model.ActiveInspectionRequest.Status, "Confirmed", StringComparison.OrdinalIgnoreCase))
                        {
                            @if (Model.ActiveInspectionRequest.ValuerDetailsSent)
                            {
                                <div class="rv-ok-note">
                                    Inspection details sent to client on
                                    @Model.ActiveInspectionRequest.ValuerDetailsSentAt?.ToString("yyyy-MM-dd HH:mm").
                                    PIN: @Model.ActiveInspectionRequest.InspectionPin
                                </div>
                            }
                            else
                            {
                                <form asp-controller="ValuerInbox"
                                      asp-action="SendInspectionDetails"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="inspectionRequestId"
                                           value="@Model.ActiveInspectionRequest.Id" />

                                    <input type="hidden"
                                           name="attrId"
                                           value="@Model.AttrId" />

                                    <button type="submit"
                                            class="rv-final-btn rv-final-btn-inspection"
                                            onclick="return confirm('Generate inspection PIN and prepare valuer details for the client?');">
                                        Send Valuer Details & PIN to Client
                                    </button>
                                </form>
                            }
                        }
                        @if (Model.ActiveInspectionRequest.ConfirmedDateTime != null)
                        {
                            <div class="rv-ok-note">
                                Confirmed: @Model.ActiveInspectionRequest.ConfirmedDateTime.Value.ToString("yyyy-MM-dd HH:mm")
                            </div>
                        }
                        @if (string.Equals(Model.ActiveInspectionRequest.Status, "Confirmed", StringComparison.OrdinalIgnoreCase))
                        {
                            @if (Model.ActiveInspectionRequest.ValuerDetailsSent)
                            {
                                <div class="rv-ok-note">
                                    Inspection details sent to client on
                                    @Model.ActiveInspectionRequest.ValuerDetailsSentAt?.ToString("yyyy-MM-dd HH:mm").
                                    PIN: @Model.ActiveInspectionRequest.InspectionPin
                                </div>
                            }
                            else
                            {
                                <form asp-controller="ValuerInbox"
                                      asp-action="SendInspectionDetails"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="inspectionRequestId"
                                           value="@Model.ActiveInspectionRequest.Id" />

                                    <input type="hidden"
                                           name="attrId"
                                           value="@Model.AttrId" />

                                    <button type="submit"
                                            class="rv-final-btn rv-final-btn-inspection"
                                            onclick="return confirm('Generate inspection PIN and prepare valuer details for the client?');">
                                        Send Valuer Details & PIN to Client
                                    </button>
                                </form>
                            }
                        }
                    }
                    else
                    {
                        <button type="button"
                                class="rv-final-btn rv-final-btn-inspection"
                                onclick="openInspectionModal();">
                            Request Physical Inspection
                        </button>
                    }
                </div>
            </div>
        </aside>
    </div>
</div>

<div id="inspectionModal" class="insp-modal-backdrop" style="display:none;">
    <div class="insp-modal">
        <div class="insp-modal-head">
            <div>Request Physical Inspection</div>
            <button type="button" onclick="closeInspectionModal()">×</button>
        </div>

        <form asp-controller="ValuerInbox"
              asp-action="ScheduleInspection"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" name="AttrId" value="@Model.AttrId" />
            <input type="hidden" name="ReviewId" value="@Model.ReviewId" />

            <div class="insp-modal-body">
                <label>Option 1</label>
                <input type="datetime-local" name="Option1" class="insp-input" required />

                <label>Option 2</label>
                <input type="datetime-local" name="Option2" class="insp-input" required />

                <label>Option 3</label>
                <input type="datetime-local" name="Option3" class="insp-input" required />

                <label>Comment to Client</label>
                <textarea name="RequestComment"
                          class="insp-textarea"
                          placeholder="Enter inspection request note for the client..."></textarea>
            </div>

            <div class="insp-modal-footer">
                <button type="button" class="insp-btn-cancel" onclick="closeInspectionModal()">Cancel</button>
                <button type="submit" class="insp-btn-submit">Send Inspection Request</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function setFinalDecision(decision) {
            const comment = document.querySelector('textarea[name="FinalComment"]');

            if (!comment || !comment.value.trim()) {
                alert('Please enter a final comment before submitting.');
                return false;
            }

            const hidden = document.getElementById('finalDecisionValue');

            if (!hidden) {
                alert('Final decision field was not found.');
                return false;
            }

            hidden.value = decision;

            if (decision === 'SubmitToOvvio') {
                return confirm('Submit this review to OVVIO extract?');
            }

            if (decision === 'ReturnToClient') {
                return confirm('Return this submission to the client for correction?');
            }

            if (decision === 'Reject') {
                return confirm('Reject this submission?');
            }

            return false;
        }

        function openInspectionModal() {
            document.getElementById('inspectionModal').style.display = 'flex';
        }

        function closeInspectionModal() {
            document.getElementById('inspectionModal').style.display = 'none';
        }
    </script>
}

@functions {
    private Microsoft.AspNetCore.Html.IHtmlContent Display(object? value)
    {
        var text = value?.ToString();

        if (string.IsNullOrWhiteSpace(text))
        {
            return new Microsoft.AspNetCore.Html.HtmlString("-");
        }

        return new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(text));
    }
}