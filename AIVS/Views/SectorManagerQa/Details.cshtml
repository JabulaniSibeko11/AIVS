@model AIVS.Models.ViewModels.SectorManager.SectorManagerQaDetailsVm
@using AIVS.Workflow
@{
    ViewData["Title"] = "Sector Manager QA " + Model.AttrNo;
    string D(object? value)
    {
        var text = value?.ToString();
        return string.IsNullOrWhiteSpace(text) ? "-" : text;
    }
    var review = Model.ReviewPage;
}

<link href="~/css/review-page.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/sector-manager-qa.css" rel="stylesheet" asp-append-version="true" />

<div class="rv-page">
    <div class="rv-actions">
        <a class="rv-btn-back" asp-action="Index">Back to Sector Manager QA</a>
        <div class="rv-top-badges">
            <span class="rv-badge">QA Status: @AttributeWorkflowStatus.QaDisplay(Model.QaStatus)</span>
            <span class="rv-badge rv-badge-dark">@Model.AttrNo</span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="rv-alert rv-alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="rv-alert rv-alert-danger">@TempData["Error"]</div>
    }

    <div class="rv-header">
        <div class="rv-title-row">
            <div>
                <h1 class="rv-title">Sector Manager QA: @Model.AttrNo</h1>
                <div class="rv-subtitle">Review the Processor's completed City-vs-client assessment. Processor decisions are read-only; record the Sector Manager QA comment below.</div>
            </div>
            <span class="rv-badge">@D(review?.FormType)</span>
        </div>

        <div class="rv-grid">
            <div class="rv-box"><div class="rv-label">Property</div><div class="rv-value">@D(Model.PropertyDescription)</div></div>
            <div class="rv-box"><div class="rv-label">Township</div><div class="rv-value">@D(Model.Township)</div></div>
            <div class="rv-box"><div class="rv-label">Sector</div><div class="rv-value">@D(Model.Sector)</div></div>
            <div class="rv-box"><div class="rv-label">Processor / Valuer</div><div class="rv-value">@D(Model.ValuerName)</div></div>
            <div class="rv-box"><div class="rv-label">Submitted</div><div class="rv-value">@(Model.ValuerSubmittedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</div></div>
        </div>
    </div>

    @{
        ViewData["EvidenceController"] = "SectorManagerQa";
    }
    @await Html.PartialAsync("~/Views/Shared/_QaReviewComparison.cshtml", Model, ViewData)

    <section class="rv-comment-panel mt-3">
        <div class="rv-comment-grid">
            <div class="rv-comment-card">
                <div class="rv-comment-title">Valuer / Processor Comment</div>
                <div class="rv-comment-readonly">@D(Model.ValuerFinalComment)</div>
            </div>
            <div class="rv-comment-card">
                <div class="rv-comment-title">Sector Manager Comment</div>
                <form method="post" id="sectorQaDecisionForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="QaId" value="@Model.QaId" />
                    <input type="hidden" name="AttrId" value="@Model.AttrId" />
                    <textarea name="Comment" class="form-control" rows="6" maxlength="2000" required placeholder="Enter the Sector Manager QA comment...">@Model.SectorManagerComment</textarea>
                    <div class="cmp-final-actions mt-3">
                        <button type="submit" class="cmp-action ovvio" formaction="@Url.Action("Approve")" onclick="return confirm('Approve this QA review and submit the final resolved values to OVVIO?');">Approve &amp; Submit to OVVIO</button>
                        <button type="submit" class="cmp-action return" formaction="@Url.Action("ReturnToValuer")" onclick="return confirm('Return this submission to the Processor for correction?');">Return to Processor</button>
                    </div>
                </form>
            </div>
        </div>
    </section>
</div>
