@model AIVS.Models.ViewModels.Home.AivsHomeDashboardVm
@using System.Globalization
@using AIVS.Workflow

@{
    ViewData["Title"] = "AIVS Dashboard";

    string F(double d) => d.ToString("0.###", CultureInfo.InvariantCulture);
    string N(int n) => n.ToString("N0", CultureInfo.InvariantCulture);

    // ---- Status donut ------------------------------------------------
    var statusColorMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        [AttributeWorkflowStatus.Attribute.Submitted] = "var(--aivs-grey)",
        [AttributeWorkflowStatus.Attribute.SectorInbox] = "var(--aivs-evening)",
        [AttributeWorkflowStatus.Attribute.Claimed] = "var(--aivs-turquoise)",
        [AttributeWorkflowStatus.Attribute.ValuerReview] = "var(--aivs-orange)",
        [AttributeWorkflowStatus.Attribute.InspectionRequired] = "var(--aivs-gold-dark)",
        [AttributeWorkflowStatus.Attribute.InspectionConfirmed] = "var(--aivs-success)",
        [AttributeWorkflowStatus.Attribute.InspectionDetailsSent] = "var(--aivs-info)",
        [AttributeWorkflowStatus.Attribute.InspectionCompleted] = "var(--aivs-success)",
        [AttributeWorkflowStatus.Attribute.InspectionExpired] = "var(--aivs-grey-light)",
        [AttributeWorkflowStatus.Attribute.ReturnedToClient] = "#8a7355",
        [AttributeWorkflowStatus.Attribute.Resubmitted] = "var(--aivs-info)",
        [AttributeWorkflowStatus.Attribute.ReturnedToValuer] = "var(--aivs-danger)",
        [AttributeWorkflowStatus.Attribute.SectorManagerQa] = "var(--aivs-gold-dark)",
        [AttributeWorkflowStatus.Attribute.SeniorManagerQa] = "var(--aivs-orange)",
        [AttributeWorkflowStatus.Attribute.Approved] = "var(--aivs-success)",
        [AttributeWorkflowStatus.Attribute.ReadyForOvvioExtract] = "var(--aivs-gold)",
        [AttributeWorkflowStatus.Attribute.OvvioInserted] = "var(--aivs-success)",
        [AttributeWorkflowStatus.Attribute.OvvioExtracted] = "var(--aivs-success)",
        [AttributeWorkflowStatus.Attribute.Rejected] = "var(--aivs-danger)",
        ["Unknown"] = "var(--aivs-border)"
    };

    var fallbackPalette = new[]
    {
        "var(--aivs-evening)", "var(--aivs-turquoise)", "var(--aivs-orange)",
        "var(--aivs-grey)", "var(--aivs-gold-dark)"
    };

    var statusTotal = Model.StatusCounts.Sum(s => s.Count);
    var donutR = 80.0;
    var donutStroke = 22.0;
    var circumference = 2 * Math.PI * donutR;
    double cumulative = 0;
    var fallbackIdx = 0;

    var donutSegments = new List<(string Label, int Count, string Color, double Dash, double Gap, double Offset)>();

    foreach (var s in Model.StatusCounts)
    {
        string label; string color;
        label = AttributeWorkflowStatus.Display(s.Status);
        if (!statusColorMap.TryGetValue(s.Status, out color))
        {
            color = fallbackPalette[fallbackIdx % fallbackPalette.Length];
            fallbackIdx++;
        }

        var fraction = statusTotal == 0 ? 0 : (double)s.Count / statusTotal;
        var dash = fraction * circumference;
        var gap = circumference - dash;
        var offset = -(cumulative * circumference);
        cumulative += fraction;

        donutSegments.Add((label, s.Count, color, dash, gap, offset));
    }

    // ---- Role-dependent secondary chart -------------------------------
    var sectorMax = Model.SectorStats.Any() ? Model.SectorStats.Max(s => s.Total) : 0;
    var topValuers = Model.ValuerStats
        .OrderByDescending(v => v.TotalAssigned)
        .Take(8)
        .ToList();
    var valuerMax = topValuers.Any() ? topValuers.Max(v => v.TotalAssigned) : 0;

    var workloadTiles = Model.Tiles.Where(t => t.CssClass != "tile-total").ToList();
    var workloadMax = workloadTiles.Any() ? workloadTiles.Max(t => t.Count) : 0;

    var tileTotalForBars = Model.TotalSubmissions == 0 ? 1 : Model.TotalSubmissions;
}

<link href="~/css/home-dashboard.css" rel="stylesheet" asp-append-version="true" />

<div class="dash-wrap">
    <div class="dash-head">
        <div>
            <div class="dash-title">@Model.DashboardTitle</div>
            <div class="dash-sub">
                @Model.DashboardScope
                @if (!string.IsNullOrWhiteSpace(Model.CurrentRole))
                {
                    <span> &bull; Role: @Model.CurrentRole</span>
                }
            </div>
        </div>

        <div class="dash-hero-stats">
            <div class="dash-hero-stat">
                <div class="dash-hero-stat-value">@N(Model.TotalSubmissions)</div>
                <div class="dash-hero-stat-label">Total records</div>
            </div>
            <div class="dash-hero-stat">
                <div class="dash-hero-stat-value">@N(Model.CompletedThisMonth)</div>
                <div class="dash-hero-stat-label">Completed this month</div>
            </div>
        </div>
    </div>

    @if (Model.IsManagerDashboard || Model.IsExecutiveDashboard)
    {
        <div class="dash-panel">
            <div class="dash-panel-title">Generate Valuer Stats</div>

            <form asp-controller="Home" asp-action="Index" method="get" class="dash-filter">
                <div>
                    <label class="form-label fw-bold">Select Valuer</label>
                    <select name="valuerUserId">
                        <option value="">All valuers</option>

                        @foreach (var valuer in Model.ValuerStats)
                        {
                            if (Model.SelectedValuerUserId == valuer.ValuerUserId)
                            {
                                <option value="@valuer.ValuerUserId" selected>
                                    @valuer.ValuerName (@valuer.Sector)
                                </option>
                            }
                            else
                            {
                                <option value="@valuer.ValuerUserId">
                                    @valuer.ValuerName (@valuer.Sector)
                                </option>
                            }
                        }
                    </select>
                </div>

                <button type="submit" class="dash-btn">Generate Stats</button>

                @if (!string.IsNullOrWhiteSpace(Model.SelectedValuerUserId))
                {
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="dash-link">
                        Clear filter
                    </a>
                }
            </form>
        </div>
    }

    <div class="dash-grid">
        @foreach (var tile in Model.Tiles)
        {
            var pct = tileTotalForBars == 0 ? 0 : Math.Min(100, (double)tile.Count / tileTotalForBars * 100);

            <div class="dash-tile @tile.CssClass">
                <div class="dash-tile-title">@tile.Title</div>
                <div class="dash-tile-count">@N(tile.Count)</div>
                <div class="dash-tile-bar">
                    <div class="dash-tile-bar-fill" style="width:@(F(pct))%;"></div>
                </div>
            </div>
        }
    </div>

    <div class="dash-insights">
        <div class="dash-panel">
            <div class="dash-panel-title">Status Breakdown</div>

            @if (statusTotal == 0)
            {
                <div class="dash-empty">No records to summarise yet.</div>
            }
            else
            {
                <div class="donut-wrap">
                    <div class="donut-figure">
                        <svg viewBox="0 0 200 200">
                            <circle cx="100" cy="100" r="@F(donutR)" fill="none" stroke="#f1efeb" stroke-width="@F(donutStroke)" />
                            @foreach (var seg in donutSegments)
                            {
                                <circle cx="100" cy="100" r="@F(donutR)" fill="none"
                                        stroke="@seg.Color" stroke-width="@F(donutStroke)"
                                        stroke-dasharray="@F(seg.Dash) @F(seg.Gap)"
                                        stroke-dashoffset="@F(seg.Offset)"
                                        transform="rotate(-90 100 100)"
                                        stroke-linecap="butt" />
                            }
                        </svg>
                        <div class="donut-center">
                            <div class="donut-center-value">@N(statusTotal)</div>
                            <div class="donut-center-label">Records</div>
                        </div>
                    </div>

                    <div class="donut-legend">
                        @foreach (var seg in donutSegments)
                        {
                            <div class="donut-legend-row">
                                <span class="donut-legend-label">
                                    <span class="donut-legend-swatch" style="background:@seg.Color;"></span>
                                    @seg.Label
                                </span>
                                <span class="donut-legend-count">@N(seg.Count)</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @if (Model.IsExecutiveDashboard)
        {
            <div class="dash-panel">
                <div class="dash-panel-title">Sector Performance</div>

                @if (!Model.SectorStats.Any())
                {
                    <div class="dash-empty">No sector data available.</div>
                }
                else
                {
                    <div class="bar-chart">
                        @foreach (var sector in Model.SectorStats.OrderByDescending(s => s.Total))
                        {
                            var pct = sectorMax == 0 ? 0 : (double)sector.Total / sectorMax * 100;

                            <div class="bar-row">
                                <div class="bar-label">@sector.Sector</div>
                                <div class="bar-track">
                                    <div class="bar-fill" style="width:@(F(pct))%; background: var(--aivs-evening);"></div>
                                </div>
                                <div class="bar-value">@N(sector.Total)</div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else if (Model.IsManagerDashboard)
        {
            <div class="dash-panel">
                <div class="dash-panel-title">Valuer Performance</div>

                @if (!topValuers.Any())
                {
                    <div class="dash-empty">No valuer assignments in your sector yet.</div>
                }
                else
                {
                    <div class="bar-chart">
                        @foreach (var valuer in topValuers)
                        {
                            var pct = valuerMax == 0 ? 0 : (double)valuer.TotalAssigned / valuerMax * 100;

                            <div class="bar-row">
                                <div class="bar-label">@valuer.ValuerName</div>
                                <div class="bar-track">
                                    <div class="bar-fill" style="width:@(F(pct))%; background: var(--aivs-turquoise);"></div>
                                </div>
                                <div class="bar-value">@N(valuer.TotalAssigned)</div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="dash-panel">
                <div class="dash-panel-title">Your Workload</div>

                @if (!workloadTiles.Any())
                {
                    <div class="dash-empty">No records assigned to you yet.</div>
                }
                else
                {
                    <div class="bar-chart">
                        @foreach (var tile in workloadTiles)
                        {
                            var pct = workloadMax == 0 ? 0 : (double)tile.Count / workloadMax * 100;

                            <div class="bar-row">
                                <div class="bar-label">@tile.Title</div>
                                <div class="bar-track">
                                    <div class="bar-fill" style="width:@(F(pct))%; background: var(--aivs-gold-dark);"></div>
                                </div>
                                <div class="bar-value">@N(tile.Count)</div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (Model.IsExecutiveDashboard)
    {
        <div class="dash-panel">
            <div class="dash-panel-title">Valuer Performance Stats</div>

            @if (Model.ValuerStats == null || !Model.ValuerStats.Any())
            {
                <div class="dash-empty">No valuer stats found.</div>
            }
            else
            {
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Valuer</th>
                            <th>Sector</th>
                            <th>Total</th>
                            <th>Claimed</th>
                            <th>Under Review</th>
                            <th>Inspection Required</th>
                            <th>Inspection Confirmed</th>
                            <th>Expired</th>
                            <th>Returned</th>
                            <th>Ready OVVIO</th>
                            <th>Rejected</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var valuer in Model.ValuerStats)
                        {
                            <tr>
                                <td>@valuer.ValuerName</td>
                                <td>@valuer.Sector</td>
                                <td><strong>@N(valuer.TotalAssigned)</strong></td>
                                <td>@N(valuer.Claimed)</td>
                                <td>@N(valuer.UnderReview)</td>
                                <td>@N(valuer.InspectionRequired)</td>
                                <td>@N(valuer.InspectionConfirmed)</td>
                                <td>@N(valuer.InspectionExpired)</td>
                                <td>@N(valuer.ReturnedToClient)</td>
                                <td>@N(valuer.ReadyForOvvio)</td>
                                <td>@N(valuer.Rejected)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="dash-panel">
            <div class="dash-panel-title">Sector Stats</div>

            <table class="dash-table">
                <thead>
                    <tr>
                        <th>Sector</th>
                        <th>Total</th>
                        <th>Sector Inbox</th>
                        <th>Assigned</th>
                        <th>Under Review</th>
                        <th>Inspections</th>
                        <th>Ready OVVIO</th>
                        <th>Rejected</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sector in Model.SectorStats)
                    {
                        <tr>
                            <td>@sector.Sector</td>
                            <td><strong>@N(sector.Total)</strong></td>
                            <td>@N(sector.SectorInbox)</td>
                            <td>@N(sector.Assigned)</td>
                            <td>@N(sector.UnderReview)</td>
                            <td>@N(sector.Inspections)</td>
                            <td>@N(sector.ReadyForOvvio)</td>
                            <td>@N(sector.Rejected)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Model.IsManagerDashboard)
    {
        <div class="dash-panel">
            <div class="dash-panel-title">Valuer Performance Stats</div>

            @if (Model.ValuerStats == null || !Model.ValuerStats.Any())
            {
                <div class="dash-empty">No valuer stats found.</div>
            }
            else
            {
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Valuer</th>
                            <th>Sector</th>
                            <th>Total</th>
                            <th>Claimed</th>
                            <th>Under Review</th>
                            <th>Inspection Required</th>
                            <th>Inspection Confirmed</th>
                            <th>Expired</th>
                            <th>Returned</th>
                            <th>Ready OVVIO</th>
                            <th>Rejected</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var valuer in Model.ValuerStats)
                        {
                            <tr>
                                <td>@valuer.ValuerName</td>
                                <td>@valuer.Sector</td>
                                <td><strong>@N(valuer.TotalAssigned)</strong></td>
                                <td>@N(valuer.Claimed)</td>
                                <td>@N(valuer.UnderReview)</td>
                                <td>@N(valuer.InspectionRequired)</td>
                                <td>@N(valuer.InspectionConfirmed)</td>
                                <td>@N(valuer.InspectionExpired)</td>
                                <td>@N(valuer.ReturnedToClient)</td>
                                <td>@N(valuer.ReadyForOvvio)</td>
                                <td>@N(valuer.Rejected)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }

    <div class="dash-panel">
        <div class="dash-panel-title">Recent Activity</div>

        @if (Model.RecentItems == null || !Model.RecentItems.Any())
        {
            <div class="dash-empty">No recent activity found.</div>
        }
        else
        {
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Property</th>
                        <th>Sector</th>
                        <th>Valuer</th>
                        <th>Status</th>
                        <th>Last Updated</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.RecentItems)
                    {
                        <tr>
                            <td>
                                <a asp-controller="ValuerInbox"
                                   asp-action="Review"
                                   asp-route-id="@item.AttrId"
                                   class="dash-link">
                                    @item.AttrNo
                                </a>
                            </td>
                            <td>@item.PropertyDescription</td>
                            <td>@item.Sector</td>
                            <td>@item.ValuerName</td>
                            <td><span class="dash-badge">@AttributeWorkflowStatus.Display(item.Status)</span></td>
                            <td>@item.LastUpdated?.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
