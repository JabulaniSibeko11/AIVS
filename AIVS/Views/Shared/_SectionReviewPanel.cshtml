@model AIVS.Models.ViewModels.ValuerInbox.ValuerReviewSectionVm

@{
    var attrId = ViewData["AttrId"];
    var reviewId = ViewData["ReviewId"];

    var decisionValue = string.IsNullOrWhiteSpace(Model.SectionDecision) ? "" : Model.SectionDecision;

    var decisionOptions = new (string Value, string Label, string Slug)[]
    {
        ("Accepted", "Accepted", "accepted"),
        ("Needs correction", "Needs Correction", "correction"),
        ("Requires inspection", "Requires Inspection", "inspection"),
        ("Not applicable", "Not Applicable", "na"),
    };
}

<link href="~/css/section-review-panel.css" rel="stylesheet" asp-append-version="true"/>

<div class="review-panel" data-section-code="@Model.SectionCode" data-decision="@decisionValue">
    <div class="review-panel-head">
        <div>Valuer Review: @Model.SectionName</div>
        <div class="review-panel-badges">
            <span class="review-panel-unsaved">Unsaved</span>
            <span class="review-panel-status">@(string.IsNullOrWhiteSpace(Model.SectionDecision) ? "Not reviewed" : Model.SectionDecision)</span>
        </div>
    </div>

    <form asp-controller="ValuerInbox"
          asp-action="SaveSectionReview"
          method="post"
          class="aivs-section-form"
          data-section-anchor="sec-@Model.SectionCode">

        @Html.AntiForgeryToken()

        <input type="hidden" name="AttrId" value="@attrId" />
        <input type="hidden" name="ReviewId" value="@reviewId" />
        <input type="hidden" name="SectionId" value="@Model.SectionId" />

        <div class="review-panel-grid">
            <div>
                <label class="fw-bold mb-1" style="font-size:13px;">Section Decision</label>

                <div class="decision-group" role="radiogroup" aria-label="Decision for @Model.SectionName">
                    @foreach (var opt in decisionOptions)
                    {
                        var radioId = $"decision_{Model.SectionId}_{opt.Slug}";

                        <input type="radio"
                               id="@radioId"
                               name="SectionDecision"
                               value="@opt.Value"
                               class="decision-radio"
                               required
                               @(decisionValue == opt.Value ? "checked" : "") />
                        <label for="@radioId" class="decision-pill decision-pill-@opt.Slug">@opt.Label</label>
                    }
                </div>

                <div class="review-check-row">
                    <label class="review-check">
                        <input type="checkbox"
                               name="RequiresCorrection"
                               value="true"
                               class="aivs-requires-correction"
                        @(Model.RequiresCorrection ? "checked" : "") />
                        Requires Correction
                    </label>
                    <input type="hidden" name="RequiresCorrection" value="false" />

                    <label class="review-check">
                        <input type="checkbox"
                               name="RequiresInspection"
                               value="true"
                               class="aivs-requires-inspection"
                        @(Model.RequiresInspection ? "checked" : "") />
                        Requires Inspection
                    </label>
                    <input type="hidden" name="RequiresInspection" value="false" />
                </div>
            </div>

            <div>
                <label class="fw-bold mb-1" style="font-size:13px;">Valuer Comment</label>
                <textarea name="SectionComment"
                          class="review-comment"
                          placeholder="Enter your review comment for this section...">@Model.SectionComment</textarea>
            </div>
        </div>

        <button type="submit" class="review-save">
            Save This Section
        </button>
    </form>
</div>

<script>
    (function () {
        var panel = document.currentScript.previousElementSibling;
        if (!panel || !panel.classList.contains('review-panel')) {
            panel = document.querySelector('.review-panel[data-section-code="@Model.SectionCode"]');
        }
        if (!panel) return;

        var wrapper = panel.closest('[id^="sec-"]') || panel;
        var form = panel.querySelector('.aivs-section-form');
        if (!form) return;

        // Live border/status feedback as the valuer picks a decision.
        form.querySelectorAll('.decision-radio').forEach(function (radio) {
            radio.addEventListener('change', function () {
                panel.setAttribute('data-decision', radio.value);
                panel.classList.add('is-dirty');

                // Smart defaults — auto-check the matching flag, valuer can still override.
                var correctionBox = form.querySelector('.aivs-requires-correction');
                var inspectionBox = form.querySelector('.aivs-requires-inspection');

                if (radio.value === 'Needs correction' && correctionBox) correctionBox.checked = true;
                if (radio.value === 'Requires inspection' && inspectionBox) inspectionBox.checked = true;

                if (window.aivsRegisterDirty) window.aivsRegisterDirty('@Model.SectionCode');
            });
        });

        form.querySelectorAll('input[type="checkbox"], textarea').forEach(function (el) {
            el.addEventListener('input', function () {
                panel.classList.add('is-dirty');
                if (window.aivsRegisterDirty) window.aivsRegisterDirty('@Model.SectionCode');
            });
        });

        // Remember where to scroll back to after the full-page redirect.
        form.addEventListener('submit', function () {
            sessionStorage.setItem('aivsScrollAnchor', '@Model.SectionCode');
            if (window.aivsClearDirty) window.aivsClearDirty('@Model.SectionCode');
        });

        // If we just redirected back here after saving, flash + scroll to this section.
        var anchor = sessionStorage.getItem('aivsScrollAnchor');
        if (anchor === '@Model.SectionCode') {
            sessionStorage.removeItem('aivsScrollAnchor');
            panel.classList.remove('is-dirty');

            requestAnimationFrame(function () {
                wrapper.scrollIntoView({ behavior: 'smooth', block: 'start' });
                panel.classList.add('just-saved');
                setTimeout(function () { panel.classList.remove('just-saved'); }, 1700);
            });
        }
    })();
</script>
