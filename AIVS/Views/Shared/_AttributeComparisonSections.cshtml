@model List<AIVS.Models.ViewModels.ValuerInbox.AttributeComparisonSectionVm>
@foreach (var sec in Model)
{
    <div class="cmp-section">
        <div class="cmp-section-head">
            <h3>@sec.SectionName</h3>
        </div>

        <div class="cmp-fields">
            @foreach (var field in sec.Fields.OrderBy(x => x.DisplayOrder))
            {
                var cardClass = !field.HasCityValue
                    ? "pending"
                    : field.IsReadOnly
                        ? "readonly"
                        : field.IsResolved
                            ? "resolved"
                            : field.HasDifference ? "different" : "matching";
                var resultName = !field.HasCityValue
                    ? "pending"
                    : field.IsResolved || !field.HasDifference ? "matching" : "different";
                var fieldKey = $"{sec.SectionCode}:{field.FieldCode}";

                <div class="cmp-field-card @cardClass"
                     data-result="@resultName"
                     data-difference="@(field.HasDifference ? "true" : "false")"
                     data-field-key="@fieldKey">

                    <div class="cmp-field-label">
                        @if (field.HasCityValue && field.HasDifference && !field.IsReadOnly && !field.CanResolveRatingDifference)
                        {
                            <input type="checkbox" class="cmp-correction" value="@fieldKey"
                                   checked="@field.IsSelectedForCorrection" aria-label="Return @field.FieldLabel to client" />
                        }
                        @field.FieldLabel
                    </div>

                    <div class="cmp-field-cols">
                        <div class="cmp-field-col">
                            <span class="cmp-col-label">City data</span>
                            <div class="cmp-field-box">@(string.IsNullOrWhiteSpace(field.CityValue) ? "—" : field.CityValue)</div>
                        </div>

                        <div class="cmp-field-col">
                            <span class="cmp-col-label">Client submitted</span>
                            <div class="cmp-field-box">@(string.IsNullOrWhiteSpace(field.ClientValue) ? "—" : field.ClientValue)</div>
                        </div>

                        <div class="cmp-field-col cmp-field-col-result">
                            <span class="cmp-col-label">Result</span>
                            <div class="cmp-field-box cmp-field-box-result">
                                @if (!field.HasCityValue)
                                {
                                    <span class="cmp-badge pending">City pending</span>
                                }
                                else if (field.IsReadOnly)
                                {
                                    <span class="cmp-badge readonly">Read only</span>
                                }
                                else if (field.IsResolved)
                                {
                                    if (string.Equals(field.ResolutionDecision, "AcceptClient", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="cmp-badge resolved">Client value accepted</span>
                                    }
                                    else
                                    {
                                        <span class="cmp-badge resolved">City value retained</span>
                                    }
                                    <div class="cmp-resolved-value">Final: <strong>@field.ResolvedValue</strong></div>
                                }
                                else if (field.HasDifference && field.CanResolveRatingDifference)
                                {
                                    <div class="cmp-rating-resolution"
                                         data-section-code="@sec.SectionCode"
                                         data-field-code="@field.FieldCode">
                                        <span class="cmp-badge different">Different</span>
                                        <div class="cmp-rating-actions">
                                            <button type="button" class="cmp-rating-btn accept" data-rating-decision="AcceptClient">
                                                <i class="fa-solid fa-check"></i> Accept Client
                                            </button>
                                            <button type="button" class="cmp-rating-btn keep-city" data-rating-decision="KeepCity">
                                                <i class="fa-solid fa-building"></i> Keep City
                                            </button>
                                        </div>
                                    </div>
                                }
                                else if (field.HasDifference)
                                {
                                    <span class="cmp-badge different">Different</span>
                                }
                                else
                                {
                                    <span class="cmp-badge matching">Matches</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
