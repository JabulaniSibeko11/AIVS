@model AIVS.Models.ViewModels.ValuerInbox.ValuerReviewPageVm
@using Microsoft.AspNetCore.Mvc.ViewFeatures

@{
    var form = Model.SubmittedForm!;

    bool isRes = form.FormType == "Residential";
    bool isSt = form.FormType == "ResidentialST";
    bool isBus = form.FormType == "BusinessCommercial";
    bool isDrc = form.FormType == "DRCMethod";

    string formLabel = form.FormType switch
    {
        "Residential" => "Residential",
        "ResidentialST" => "Residential — Sectional Title",
        "BusinessCommercial" => "Non-Residential / Business and Commercial",
        "DRCMethod" => "DRC Method",
        _ => "Attribute Submission"
    };
}

<link href="~/css/submitted-form.css" rel="stylesheet" asp-append-version="true" />

<div class="sub-card">
    <div class="sub-head">Submitted Form: <span>@formLabel</span></div>
    <div class="sub-body">
        <div class="def-grid">
            <div class="def-item">
                <div class="def-label">Reference No</div>
                <div class="def-value">@Display(form.AttrNo)</div>
            </div>
            <div class="def-item">
                <div class="def-label">Form Type</div>
                <div class="def-value">@Display(formLabel)</div>
            </div>
        </div>
    </div>
</div>

<div class="sub-card">
    <div class="sub-head">Valuation <span>Details</span></div>
    <div class="sub-body">
        <div class="aivs-section-block" id="sec-VALUATION_DETAILS">
            <div class="def-grid">
                <div class="def-item"><div class="def-label">Valuation Category on Roll</div><div class="def-value">@Display(form.ValuationDetails?.ValuationCategoryOnRoll)</div></div>
                <div class="def-item"><div class="def-label">Actual Use</div><div class="def-value">@Display(form.ValuationDetails?.ActualUse)</div></div>
                <div class="def-item"><div class="def-label">Mixed Use</div><div class="def-value">@Display(form.ValuationDetails?.IsMixedUse == true ? "Yes" : "No")</div></div>
                <div class="def-item"><div class="def-label">Alternate Usages</div><div class="def-value">@Display(form.ValuationDetails?.AlternateUsages)</div></div>
            </div>
            @await RenderReviewPanel("VALUATION_DETAILS")
        </div>
    </div>
</div>

@if (isRes || isSt)
{
    <div class="sub-card">
        <div class="sub-head">
            Section 3:
            <span>@(isSt ? "Sectional Title Residential Attributes" : "Residential Attributes")</span>
        </div>

        <div class="sub-body">
            <div class="sub-section-title">Primary Attributes</div>

            <div class="aivs-section-block" id="sec-PRIMARY_ATTRIBUTES">
                <div class="def-grid">
                    @if (isRes)
                    {
                        <div class="def-item"><div class="def-label">TLA 1</div><div class="def-value">@Display(form.PrimaryAttributes?.Tla1)</div></div>
                        <div class="def-item"><div class="def-label">TLA 2</div><div class="def-value">@Display(form.PrimaryAttributes?.Tla2)</div></div>
                        <div class="def-item"><div class="def-label">TLA 3</div><div class="def-value">@Display(form.PrimaryAttributes?.Tla3)</div></div>
                        <div class="def-item"><div class="def-label">Garage</div><div class="def-value">@Display(form.PrimaryAttributes?.Garage)</div></div>
                        <div class="def-item"><div class="def-label">Carport</div><div class="def-value">@Display(form.PrimaryAttributes?.CarportCp)</div></div>
                        <div class="def-item"><div class="def-label">Granny Flat</div><div class="def-value">@Display(form.PrimaryAttributes?.GrannyFlatGf)</div></div>
                        <div class="def-item"><div class="def-label">Staff Quarters</div><div class="def-value">@Display(form.PrimaryAttributes?.StaffQuartersSq)</div></div>
                        <div class="def-item"><div class="def-label">Storage</div><div class="def-value">@Display(form.PrimaryAttributes?.Storage)</div></div>
                    }

                    @if (isSt)
                    {
                        <div class="def-item"><div class="def-label">ST Main</div><div class="def-value">@Display(form.PrimaryAttributes?.STMain)</div></div>
                        <div class="def-item"><div class="def-label">Garage</div><div class="def-value">@Display(form.PrimaryAttributes?.Garage)</div></div>
                        <div class="def-item"><div class="def-label">Carport</div><div class="def-value">@Display(form.PrimaryAttributes?.CarportCp)</div></div>
                        <div class="def-item"><div class="def-label">Storage</div><div class="def-value">@Display(form.PrimaryAttributes?.Storage)</div></div>
                    }
                </div>

                @await RenderReviewPanel("PRIMARY_ATTRIBUTES")
            </div>

            <div class="sub-section-title">Secondary Attributes</div>

            <div class="aivs-section-block" id="sec-SECONDARY_ATTRIBUTES">
                <div class="def-grid">
                    <div class="def-item"><div class="def-label">Storeys</div><div class="def-value">@Display(form.SecondaryAttributes?.Storeys)</div></div>
                    <div class="def-item"><div class="def-label">Security</div><div class="def-value">@Display(form.SecondaryAttributes?.Security)</div></div>
                    <div class="def-item"><div class="def-label">Noise</div><div class="def-value">@Display(form.SecondaryAttributes?.Noise)</div></div>
                    <div class="def-item"><div class="def-label">Topography</div><div class="def-value">@Display(form.SecondaryAttributes?.Topography)</div></div>
                    <div class="def-item"><div class="def-label">Quality</div><div class="def-value">@Display(form.SecondaryAttributes?.Quality)</div></div>
                    <div class="def-item"><div class="def-label">Condition</div><div class="def-value">@Display(form.SecondaryAttributes?.Condition)</div></div>
                    <div class="def-item"><div class="def-label">Swimming Pool</div><div class="def-value">@Display(form.SecondaryAttributes?.SwimmingPool == true ? "Yes" : "No")</div></div>
                    <div class="def-item"><div class="def-label">Tennis Court</div><div class="def-value">@Display(form.SecondaryAttributes?.TennisCourt == true ? "Yes" : "No")</div></div>

                    @if (isSt)
                    {
                        <div class="def-item"><div class="def-label">ST Condition</div><div class="def-value">@Display(form.SecondaryAttributes?.STCondition)</div></div>
                        <div class="def-item"><div class="def-label">ST Floor</div><div class="def-value">@Display(form.SecondaryAttributes?.STFloor)</div></div>
                    }
                </div>

                @await RenderReviewPanel("SECONDARY_ATTRIBUTES")
            </div>
        </div>
    </div>
}

@if (isBus)
{
    <div class="sub-card">
        <div class="sub-head">Section 3: <span>Non-Residential Buildings &amp; Sections</span></div>

        <div class="sub-body">
            <div class="sub-section-title">Buildings</div>

            <div class="aivs-section-block" id="sec-BUSINESS_BUILDINGS">
                @if (form.BusinessBuildings == null || !form.BusinessBuildings.Any())
                {
                    <div class="sub-empty">No business building details submitted.</div>
                }
                else
                {
                    <table class="sub-table">
                        <thead>
                            <tr>
                                <th>Building Nr</th>
                                <th>Quality</th>
                                <th>Condition</th>
                                <th>Year Built</th>
                                <th>Storeys</th>
                                <th>GBA</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in form.BusinessBuildings)
                            {
                                <tr>
                                    <td>@Display(b.BuildingNr)</td>
                                    <td>@Display(b.Quality)</td>
                                    <td>@Display(b.Condition)</td>
                                    <td>@Display(b.YearBuilt)</td>
                                    <td>@Display(b.Storeys)</td>
                                    <td>@Display(b.GBA)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @await RenderReviewPanel("BUSINESS_BUILDINGS")
            </div>

            <div class="sub-section-title">Sections</div>

            <div class="aivs-section-block" id="sec-BUSINESS_SECTIONS">
                @if (form.BusinessSections == null || !form.BusinessSections.Any())
                {
                    <div class="sub-empty">No business section details submitted.</div>
                }
                else
                {
                    <table class="sub-table">
                        <thead>
                            <tr>
                                <th>Building Nr</th>
                                <th>Usage</th>
                                <th>GBA</th>
                                <th>NLA</th>
                                <th>Rental</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in form.BusinessSections)
                            {
                                <tr>
                                    <td>@Display(s.BuildingNr)</td>
                                    <td>@Display(s.Usage)</td>
                                    <td>@Display(s.GBA)</td>
                                    <td>@Display(s.NLA)</td>
                                    <td>@Display(s.Rental)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @await RenderReviewPanel("BUSINESS_SECTIONS")
            </div>

            <div class="sub-section-title">General</div>

            <div class="aivs-section-block" id="sec-BUSINESS_GENERAL">
                <div class="def-grid">
                    <div class="def-item"><div class="def-label">Unutilised Land Extent</div><div class="def-value">@Display(form.BusinessGeneral?.UnutilisedLandExtent)</div></div>
                    <div class="def-item"><div class="def-label">Unutilised Land Rate</div><div class="def-value">@Display(form.BusinessGeneral?.UnutilisedLandRate)</div></div>
                </div>

                @await RenderReviewPanel("BUSINESS_GENERAL")
            </div>
        </div>
    </div>
}

@if (isDrc)
{
    <div class="sub-card">
        <div class="sub-head">Section 3: <span>DRC Method — Buildings &amp; Land</span></div>

        <div class="sub-body">
            <div class="sub-section-title">Buildings</div>

            <div class="aivs-section-block" id="sec-DRC_BUILDINGS">
                @if (form.DrcBuildings == null || !form.DrcBuildings.Any())
                {
                    <div class="sub-empty">No DRC building details submitted.</div>
                }
                else
                {
                    <table class="sub-table">
                        <thead>
                            <tr>
                                <th>Building Description</th>
                                <th>Quality</th>
                                <th>GBA</th>
                                <th>Condition</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in form.DrcBuildings)
                            {
                                <tr>
                                    <td>@Display(b.BuildingDescription)</td>
                                    <td>@Display(b.Quality)</td>
                                    <td>@Display(b.GrossBuildingArea)</td>
                                    <td>@Display(b.Condition)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @await RenderReviewPanel("DRC_BUILDINGS")
            </div>

            <div class="sub-section-title">Improvements</div>

            <div class="aivs-section-block" id="sec-DRC_IMPROVEMENTS">
                @if (form.DrcImprovements == null || !form.DrcImprovements.Any())
                {
                    <div class="sub-empty">No DRC improvement details submitted.</div>
                }
                else
                {
                    <table class="sub-table">
                        <thead>
                            <tr>
                                <th>Improvement Description</th>
                                <th>Quality</th>
                                <th>Area / Unit</th>
                                <th>Condition</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in form.DrcImprovements)
                            {
                                <tr>
                                    <td>@Display(i.ImprovementDescription)</td>
                                    <td>@Display(i.Quality)</td>
                                    <td>@Display(i.AreaUnit)</td>
                                    <td>@Display(i.Condition)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @await RenderReviewPanel("DRC_IMPROVEMENTS")
            </div>

            <div class="sub-section-title">Vacant Land</div>

            <div class="aivs-section-block" id="sec-DRC_VACANT_LAND">
                @if (form.DrcVacantLands == null || !form.DrcVacantLands.Any())
                {
                    <div class="sub-empty">No DRC vacant land details submitted.</div>
                }
                else
                {
                    <table class="sub-table">
                        <thead>
                            <tr>
                                <th>Region</th>
                                <th>Area</th>
                                <th>Rate</th>
                                <th>Vacant Land Cost</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in form.DrcVacantLands)
                            {
                                <tr>
                                    <td>@Display(v.Region)</td>
                                    <td>@Display(v.Area)</td>
                                    <td>@Display(v.Rate)</td>
                                    <td>@Display(v.VacantLandCost)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @await RenderReviewPanel("DRC_VACANT_LAND")
            </div>
        </div>
    </div>
}

<div class="sub-card">
    <div class="sub-head">Section 4: <span>Additional Comments</span></div>

    <div class="sub-body">
        <div class="aivs-section-block" id="sec-ADDITIONAL_COMMENTS">
            @Display(form.ClientComment)

            @await RenderReviewPanel("ADDITIONAL_COMMENTS")
        </div>
    </div>
</div>

<div class="sub-card">
    <div class="sub-head">Section 5: <span>Declaration</span></div>

    <div class="sub-body">
        <div class="aivs-section-block" id="sec-DECLARATION">
            <div class="def-grid">
                <div class="def-item"><div class="def-label">Declaration Accepted</div><div class="def-value">@Display(form.Declaration?.DeclarationAccepted == true ? "Yes" : "No")</div></div>
                <div class="def-item"><div class="def-label">Signature Name</div><div class="def-value">@Display(form.Declaration?.SignatureName)</div></div>
            </div>

            @await RenderReviewPanel("DECLARATION")
        </div>
    </div>
</div>

@functions {
    private Microsoft.AspNetCore.Html.IHtmlContent Display(object? value)
    {
        var text = value?.ToString();

        if (string.IsNullOrWhiteSpace(text))
        {
            return new Microsoft.AspNetCore.Html.HtmlString("<span class='def-empty'>Not supplied</span>");
        }

        return new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(text));
    }

    private AIVS.Models.ViewModels.ValuerInbox.ValuerReviewSectionVm? GetReviewSection(string sectionCode)
    {
        return Model.Sections.FirstOrDefault(x =>
            string.Equals(x.SectionCode, sectionCode, StringComparison.OrdinalIgnoreCase));
    }

    private async Task<Microsoft.AspNetCore.Html.IHtmlContent> RenderReviewPanel(string sectionCode)
    {
        var section = GetReviewSection(sectionCode);

        if (section == null)
        {
            return Microsoft.AspNetCore.Html.HtmlString.Empty;
        }

        var viewData = new ViewDataDictionary(ViewData)
        {
            ["AttrId"] = Model.AttrId,
            ["ReviewId"] = Model.ReviewId
        };

        return await Html.PartialAsync("_SectionReviewPanel", section, viewData);
    }
}
