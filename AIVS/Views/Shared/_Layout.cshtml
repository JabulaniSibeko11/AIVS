@using AIVS.Services.Interface
@inject IUserManagementService UserManagementService

@{
    var currentUser = await UserManagementService.GetCurrentUserAsync(User);

    var displayName = currentUser.HasAccess && !string.IsNullOrWhiteSpace(currentUser.FullName)
        ? currentUser.FullName
        : User.Identity?.Name ?? "Unknown User";

    var position = currentUser.HasAccess && !string.IsNullOrWhiteSpace(currentUser.Position)
        ? currentUser.Position
        : currentUser.HasAccess && !string.IsNullOrWhiteSpace(currentUser.Role)
            ? currentUser.Role
            : "Access not verified";

    var accessMessage = currentUser.AccessMessage ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AIVS</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AIVS.styles.css" asp-append-version="true" />

    <style>
            :root {
                --aivs-black: #000000;
                --aivs-gold: #e6b000;
                --aivs-gold-dark: #c89a00;
                --aivs-white: #ffffff;
                --aivs-page-bg: #f4f5f7;
            }

            html, body {
                min-height: 100%;
                background: var(--aivs-page-bg);
                margin: 0;
                font-family: "Segoe UI", Arial, sans-serif;
            }

            .aivs-topbar {
                background: var(--aivs-black);
                color: var(--aivs-white);
                min-height: 44px;
                padding: 0 22px;
                display: flex;
                align-items: center;
            }

            .aivs-topbar-inner {
                width: 100%;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 15px;
            }

            .aivs-user-position {
                font-size: 14px;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: .3px;
                color: #ffffff;
            }

            .aivs-sector {
                margin-left: 10px;
                font-size: 12px;
                font-weight: 600;
                color: #d6d6d6;
                text-transform: none;
            }

            .aivs-user-name {
                font-size: 14px;
                font-weight: 800;
                color: #ffffff;
                white-space: nowrap;
            }

            .aivs-goldbar {
                background: var(--aivs-gold);
                border-bottom: 1px solid var(--aivs-gold-dark);
                box-shadow: 0 2px 8px rgba(0,0,0,.12);
                min-height: 56px;
            }

                .aivs-goldbar .navbar-brand {
                    color: #111111 !important;
                    font-size: 22px;
                    font-weight: 900;
                    letter-spacing: .4px;
                    margin-right: 24px;
                }

                .aivs-goldbar .nav-link {
                    color: #111111 !important;
                    font-weight: 800;
                    padding: 10px 13px !important;
                    border-radius: 6px;
                    margin-right: 4px;
                }

                    .aivs-goldbar .nav-link:hover {
                        background: rgba(255,255,255,.38);
                        color: #000000 !important;
                    }

                .aivs-goldbar .navbar-toggler {
                    border-color: rgba(0,0,0,.45);
                }

            .aivs-access-warning {
                background: #fff3cd;
                border-bottom: 1px solid #e0b000;
                color: #5c4300;
                padding: 9px 22px;
                font-size: 13px;
                font-weight: 700;
            }

            .aivs-main-container {
                padding-top: 24px;
                padding-bottom: 48px;
            }

            .aivs-footer {
                background: #ffffff;
                border-top: 1px solid #dedede;
                color: #555555;
                padding: 14px 0;
                font-size: 13px;
            }

            @@media (max-width: 576px) {
                .aivs-topbar {
                    padding: 8px 14px;
                }

                .aivs-topbar-inner {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 4px;
                }

                .aivs-user-name {
                    white-space: normal;
                }

                .aivs-goldbar .navbar-brand {
                    font-size: 20px;
                }
            }
    </style>
</head>

<body>
    <header>
        <!-- BLACK TOP NAV -->
        <div class="aivs-topbar">
            <div class="aivs-topbar-inner">
                <div class="aivs-user-position">
                    @position
                </div>

                <div class="aivs-user-name">
                    @displayName
                </div>
            </div>
        </div>

        <!-- GOLD BOTTOM NAV -->
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm aivs-goldbar">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    AIVS
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="SectorInbox" asp-action="Index">
                                Sector Inbox
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="ValuerInbox" asp-action="Index">
                                Valuer Inbox
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Schedule" asp-action="Index">
                                Schedule
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Reports" asp-action="Index">
                                Reports
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Me">
                                My Access
                            </a>
                        </li>
                    </ul>
                </div>
                <a asp-controller="Notifications"
                       asp-action="Index"
                       class="nav-link position-relative">
                    <i class="fa-solid fa-bell"></i>
                    <span id="aivsNotificationBadge"
                          class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                          style="display:none;">
                        0
                    </span>
                </a>
            </div>
        </nav>

        @if (!currentUser.HasAccess && !string.IsNullOrWhiteSpace(accessMessage))
        {
            <div class="aivs-access-warning">
                @accessMessage
            </div>
        }
    </header>

    <div class="container-fluid aivs-main-container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="aivs-footer">
        <div class="container-fluid">
            &copy; 2026 - AIVS - Attribute Inspection & Verification System
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
            async function loadAivsNotificationCount() {
                try {
                    const response = await fetch('/Notifications/UnreadCount');
                    if (!response.ok) return;

                    const data = await response.json();
                    const badge = document.getElementById('aivsNotificationBadge');

                    if (!badge) return;

                    if (data.count && data.count > 0) {
                        badge.textContent = data.count;
                        badge.style.display = 'inline-block';
                    } else {
                        badge.style.display = 'none';
                    }
                } catch {
                    // silent
                }
            }

            document.addEventListener('DOMContentLoaded', loadAivsNotificationCount);
    </script>
</body>
</html>