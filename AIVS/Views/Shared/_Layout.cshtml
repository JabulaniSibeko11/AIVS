@using AIVS.Services.Interface
@inject IUserManagementService UserManagementService

@{
    var currentUser = await UserManagementService.GetCurrentUserAsync(User);

    var displayName = currentUser.HasAccess && !string.IsNullOrWhiteSpace(currentUser.FullName)
        ? currentUser.FullName
        : User.Identity?.Name ?? "Unknown User";

    var position = currentUser.HasAccess && !string.IsNullOrWhiteSpace(currentUser.Position)
        ? currentUser.Position
        : currentUser.HasAccess && !string.IsNullOrWhiteSpace(currentUser.Role)
            ? currentUser.Role
            : "Access not verified";

    var accessMessage = currentUser.AccessMessage ?? "";

    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";

    Func<string, string> navActive = controllerName =>
        string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";

    Func<string, string, string> navActiveExact = (controllerName, actionName) =>
        string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentAction, actionName, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AIVS</title>

    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AIVS.styles.css" asp-append-version="true" />
    <link href="~/css/_layout.css" rel="stylesheet" asp-append-version="true" />
</head>

<body>
    <div id="aivsPageLoader" class="aivs-loader" aria-hidden="true"></div>

    <header>
        <!-- BLACK IDENTITY BAR -->
        <div class="aivs-topbar">
            <div class="aivs-topbar-inner">
                <div class="aivs-user-position">
                    @position
                </div>

                <div class="aivs-user-name">
                    @displayName
                </div>
            </div>
        </div>

        <!-- GOLD NAV BAR -->
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm aivs-goldbar">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    AIVS
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link @navActiveExact("Home", "Index")" asp-area="" asp-controller="Home" asp-action="Index">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @navActive("SectorInbox")" asp-area="" asp-controller="SectorInbox" asp-action="Index">
                                Sector Inbox
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @navActive("ValuerInbox")" asp-area="" asp-controller="ValuerInbox" asp-action="Index">
                                Valuer Inbox
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @navActive("Account")" asp-area="" asp-controller="Account" asp-action="Me">
                                My Access
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @navActiveExact("Home", "Help")" asp-area="" asp-controller="Home" asp-action="Help">
                                Help
                            </a>
                        </li>
                    </ul>
                </div>

                <a asp-controller="Notifications"
                       asp-action="Index"
                       class="aivs-bell"
                       aria-label="Notifications">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 3C9.79 3 8 4.79 8 7v2.34C8 10.7 7.53 12 6.7 13l-1.2 1.44C4.9 15.1 5.36 16 6.13 16h11.74c.77 0 1.23-.9.63-1.56L17.3 13c-.83-1-1.3-2.3-1.3-3.66V7c0-2.21-1.79-4-4-4z"
                              stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                        <path d="M10 18.5a2 2 0 0 0 4 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                    <span id="aivsNotificationBadge" class="aivs-bell-badge" style="display:none;">0</span>
                </a>
            </div>
        </nav>

        @if (!currentUser.HasAccess && !string.IsNullOrWhiteSpace(accessMessage))
        {
            <div class="aivs-access-warning">
                @accessMessage
            </div>
        }
    </header>

    <div class="container-fluid aivs-main-container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="aivs-footer">
        <div class="container-fluid aivs-footer-inner">
            <div class="aivs-footer-left">
                <span class="aivs-footer-mark">AIVS</span>
                <span class="aivs-footer-sep">&middot;</span>
                <span class="aivs-footer-copy">&copy; 2026 City of Johannesburg</span>
            </div>
            <div class="aivs-footer-links">
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
            async function loadAivsNotificationCount() {
                try {
                    const response = await fetch('/Notifications/UnreadCount');
                    if (!response.ok) return;

                    const data = await response.json();
                    const badge = document.getElementById('aivsNotificationBadge');

                    if (!badge) return;

                    if (data.count && data.count > 0) {
                        badge.textContent = data.count;
                        badge.style.display = 'inline-block';
                    } else {
                        badge.style.display = 'none';
                    }
                } catch {
                    // silent
                }
            }

            document.addEventListener('DOMContentLoaded', loadAivsNotificationCount);

            // Page loader — thin gold sweep shown on navigation
            (function () {
                const loader = document.getElementById('aivsPageLoader');
                if (!loader) return;

                function showLoader() {
                    loader.classList.add('active');
                }

                function hideLoader() {
                    loader.classList.remove('active');
                }

                document.addEventListener('click', function (e) {
                    const link = e.target.closest('a');
                    if (!link) return;

                    const href = link.getAttribute('href');
                    if (!href || href.startsWith('#') || href.startsWith('javascript:') || href.startsWith('mailto:')) return;
                    if (link.target === '_blank' || link.hasAttribute('download') || link.dataset.noLoader) return;

                    showLoader();
                });

                document.addEventListener('submit', function (e) {
                    if (e.target && e.target.tagName === 'FORM') {
                        showLoader();
                    }
                });

                window.addEventListener('pageshow', hideLoader);
            })();
    </script>
</body>
</html>