@model AIVS.Models.ViewModels.ValuerInbox.ValuerReviewPageVm
@{
    var tab1 = Model.ComparisonSections.Where(x => x.TabNumber == 1).ToList();
    var tab2 = Model.ComparisonSections.Where(x => x.TabNumber == 2).ToList();
    var allSections = tab1.Concat(tab2).ToList();

    var property = Model.SubmittedForm?.PropertyDetails;
    var owner = Model.SubmittedForm?.ContactInfos?
        .FirstOrDefault(x => string.Equals(x.ContactType, "Owner", StringComparison.OrdinalIgnoreCase))
        ?? Model.SubmittedForm?.ContactInfos?.FirstOrDefault();
    var ownerName = owner == null
        ? null
        : (!string.IsNullOrWhiteSpace(owner.CompanyName)
            ? owner.CompanyName
            : string.Join(" ", new[] { owner.FirstNames, owner.LastName }.Where(x => !string.IsNullOrWhiteSpace(x))));

    Microsoft.AspNetCore.Html.IHtmlContent Disp(object? value)
    {
        var text = value?.ToString();
        return new Microsoft.AspNetCore.Html.HtmlString(
            string.IsNullOrWhiteSpace(text) ? "Not supplied" : System.Net.WebUtility.HtmlEncode(text));
    }
}

<section class="cmp-shell" id="attributeComparison">
    <fieldset disabled="@(Model.IsLockedByAnotherUser ? "disabled" : null)">

        <!-- ══ STEP 1 — Confirm the property ══════════════════════════ -->
        <div class="cmp-step-head">
            <span class="cmp-step-num">1</span>
            <div>
                <h2>Confirm the property</h2>
                <p>Make sure this submission belongs to the correct City property before reviewing anything else.</p>
            </div>
        </div>

        <div class="cmp-overview-card">
            <div class="cmp-overview-grid cmp-overview-grid-compact">
                <div><small>Property description</small><strong>@Disp(Model.PropertyDescription ?? property?.PropertyDesc)</strong></div>
                <div><small>Premise ID</small><strong>@Disp(property?.PremiseId)</strong></div>
                <div><small>Township</small><strong>@Disp(Model.Township ?? property?.Township)</strong></div>
                <div><small>Client name / company</small><strong>@Disp(ownerName)</strong></div>
                <div><small>Email address</small><strong>@Disp(owner?.Email)</strong></div>
                <div><small>Contact number</small><strong>@Disp(owner?.CellNo)</strong></div>
            </div>
        </div>

        <!-- 1.1 Lodged evidence (was "Client Uploaded Evidence") -->
        <div class="cmp-substep" id="uploaded-evidence">
            @{
                var lodgedCount = Model.EvidenceFiles?.Count ?? 0;
            }
            @if (lodgedCount == 0)
            {
                <div class="cmp-substep-toggle cmp-substep-static">
                    <div class="cmp-substep-left">
                        <span class="cmp-substep-num">1.1</span>
                        <strong>Lodged evidence</strong>
                    </div>
                    <span class="cmp-substep-empty-label">No evidence uploaded</span>
                </div>
            }
            else
            {
                <button type="button" class="cmp-substep-toggle open" data-substep-toggle="lodged">
                    <div class="cmp-substep-left">
                        <span class="cmp-substep-num">1.1</span>
                        <strong>Lodged evidence</strong>
                        <span class="cmp-substep-sub">@lodgedCount file(s)</span>
                    </div>
                    <i class="fa-solid fa-chevron-down cmp-substep-chevron"></i>
                </button>

                <div class="cmp-substep-body" id="substep-lodged">
                    <div class="cmp-substep-actions">
                        <a class="rv-evidence-zip" asp-controller="ValuerInbox" asp-action="DownloadEvidenceZip" asp-route-attrId="@Model.AttrId" asp-route-kind="client">
                            <i class="fa-solid fa-file-zipper"></i> Download All
                        </a>
                    </div>
                    <div class="rv-evidence-grid">
                        @foreach (var file in Model.EvidenceFiles!)
                        {
                            <article class="rv-evidence-file-card">
                                <div class="rv-evidence-file-icon">
                                    <i class="@(string.Equals(file.FileType, "application/pdf", StringComparison.OrdinalIgnoreCase) ? "fa-solid fa-file-pdf" : "fa-solid fa-file-image")"></i>
                                </div>
                                <div class="rv-evidence-file-info">
                                    <div class="rv-evidence-file-name" title="@file.FileName">@Disp(file.FileName)</div>
                                    <div class="rv-evidence-file-meta">
                                        @(file.UploadedDateTime?.ToString("dd MMM yyyy HH:mm") ?? "Date unavailable")
                                        @if (file.FileSize.HasValue)
                                        {
                                            <span> · @((file.FileSize.Value / 1024.0).ToString("N0")) KB</span>
                                        }
                                    </div>
                                </div>
                                <div class="rv-evidence-file-actions">
                                    <a class="rv-evidence-view"
                                           asp-controller="ValuerInbox"
                                           asp-action="ClientEvidenceFile"
                                           asp-route-attrId="@Model.AttrId"
                                           asp-route-evidenceKey="@file.EvidenceKey"
                                           asp-route-download="false"
                                           target="_blank" rel="noopener">
                                        <i class="fa-solid fa-eye"></i> View
                                    </a>
                                    <a class="rv-evidence-download"
                                           asp-controller="ValuerInbox"
                                           asp-action="ClientEvidenceFile"
                                           asp-route-attrId="@Model.AttrId"
                                           asp-route-evidenceKey="@file.EvidenceKey"
                                           asp-route-download="true">
                                        <i class="fa-solid fa-download"></i> Download
                                    </a>
                                </div>
                            </article>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- 1.2 Inspection evidence -->
        <div class="cmp-substep" id="inspection-evidence">
            @{
                var inspectionCount = Model.PhysicalInspectionEvidenceFiles?.Count ?? 0;
            }
            @if (inspectionCount == 0)
            {
                <div class="cmp-substep-toggle cmp-substep-static">
                    <div class="cmp-substep-left">
                        <span class="cmp-substep-num">1.2</span>
                        <strong>Inspection evidence</strong>
                    </div>
                    <span class="cmp-substep-empty-label">No evidence uploaded</span>
                </div>
            }
            else
            {
                <button type="button" class="cmp-substep-toggle" data-substep-toggle="inspection">
                    <div class="cmp-substep-left">
                        <span class="cmp-substep-num">1.2</span>
                        <strong>Inspection evidence</strong>
                        <span class="cmp-substep-sub">@inspectionCount file(s)</span>
                    </div>
                    <i class="fa-solid fa-chevron-down cmp-substep-chevron"></i>
                </button>

                <div class="cmp-substep-body" id="substep-inspection" hidden>
                    <div class="rv-evidence-grid">
                        @foreach (var file in Model.PhysicalInspectionEvidenceFiles!)
                        {
                            <article class="rv-evidence-file-card">
                                <div class="rv-evidence-file-icon">
                                    <i class="@(file.IsImage ? "fa-solid fa-file-image" : "fa-solid fa-file")"></i>
                                </div>
                                <div class="rv-evidence-file-info">
                                    <div class="rv-evidence-file-name" title="@file.FileName">@Disp(file.FileName)</div>
                                    <div class="rv-evidence-file-meta">
                                        @file.UploadedAt.ToString("dd MMM yyyy HH:mm")
                                        <span> · @(file.UploadedByName ?? file.UploadedBySapNumber ?? "Valuer / Sector Manager")</span>
                                        <span> · @file.FileSizeDisplay</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(file.EvidenceComment))
                                    {
                                        <div class="rv-block-note" style="margin-top:8px;">
                                            <strong>Inspection note:</strong> @Disp(file.EvidenceComment)
                                        </div>
                                    }
                                </div>
                                <div class="rv-evidence-file-actions">
                                    <a class="rv-evidence-view"
                                           asp-controller="ValuerInbox"
                                           asp-action="PhysicalInspectionEvidenceFile"
                                           asp-route-id="@file.Id"
                                           target="_blank" rel="noopener">
                                        <i class="fa-solid fa-eye"></i> View
                                    </a>
                                    <a class="rv-evidence-download"
                                           asp-controller="ValuerInbox"
                                           asp-action="PhysicalInspectionEvidenceFile"
                                           asp-route-id="@file.Id"
                                           asp-route-download="true">
                                        <i class="fa-solid fa-download"></i> Download
                                    </a>
                                </div>
                            </article>
                        }
                    </div>
                </div>
            }
        </div>

        @if (!Model.HasCityData)
        {
            <div class="cmp-empty">
                <strong>City snapshot is not loaded yet.</strong>
                The sections and values submitted by the client are displayed below. The City column will remain empty until
                Attr_CityAttributeValues is loaded for premise <strong>@(property?.PremiseId ?? "not supplied")</strong>.
            </div>
        }

        <!-- ══ STEP 2 — Compare fields (no tabs, one continuous view) ═══ -->
        @if (allSections.Any())
        {
            <div class="cmp-step-head">
                <span class="cmp-step-num">2</span>
                <div>
                    <h2>Compare fields</h2>
                    <p>Client submission against the City record, section by section.</p>
                </div>
            </div>

            <div class="cmp-toolbar cmp-toolbar-simple">
                <div class="cmp-counts">
                    @if (Model.HasCityData)
                    {
                        <span class="different" id="cmpDifferenceCount">@Model.DifferenceCount differences</span>
                        <span class="matching" id="cmpMatchingCount">@Model.MatchingCount matches</span>
                    }
                    <span>@Model.MissingCityCount awaiting City values</span>
                </div>
                <label class="cmp-toggle"><input type="checkbox" id="cmpDifferencesOnly" checked="@Model.DifferencesOnly" /> Show differences only</label>
            </div>

            <div class="cmp-panel active" data-cmp-panel="all">
                @await Html.PartialAsync("_AttributeComparisonSections", allSections)
            </div>
        }

        <!-- ══ STEP 3 — Record your decision ═══════════════════════════ -->
        <div class="cmp-step-head">
            <span class="cmp-step-num">3</span>
            <div>
                <h2>Record your decision</h2>
                <p>Add internal evidence if you used any, leave a comment, then choose what happens next.</p>
            </div>
        </div>

        <div class="cmp-substep" id="processor-evidence">
            <button type="button" class="cmp-substep-toggle" id="processorEvidenceToggle" aria-expanded="false">
                <div class="cmp-substep-left">
                    <i class="fa-solid fa-shield-halved" style="color:var(--aivs-gold);"></i>
                    <strong>Internal evidence</strong>
                    <span class="cmp-substep-sub" id="processorEvidenceToggleSub">
                        @(Model.ProcessorEvidenceFiles != null && Model.ProcessorEvidenceFiles.Any()
                            ? $"{Model.ProcessorEvidenceFiles.Count} file(s) already saved"
                            : "Optional — add if you used any to verify this submission")
                    </span>
                </div>
                <i class="fa-solid fa-chevron-down cmp-substep-chevron"></i>
            </button>

            <div class="cmp-substep-body" id="processorEvidenceBody" hidden>
                <div class="rv-small-text mb-2">
                    Upload the internal evidence used to verify the client's submitted attributes. This may include PDF files, Excel workbooks, CSV files and screenshots.
                    The original filename is kept and the evidence is saved under <strong>\Processor\Evidence</strong> for the audit trail.
                </div>

                <div class="rv-internal-evidence-form" id="processorEvidenceCapture">
                    <label class="fw-bold mb-1" style="font-size:13px;">Internal evidence files</label>
                    <input type="file" id="processorEvidenceFiles" multiple
                           accept=".pdf,.xlsx,.xls,.csv,.png,.jpg,.jpeg"
                           class="form-control mb-2" />

                    <label class="fw-bold mb-1" style="font-size:13px;">Evidence note</label>
                    <textarea id="processorEvidenceComment" class="form-control mb-2" rows="2" maxlength="2000"
                              placeholder="Explain what this evidence was used to verify or why the physical inspection is required."></textarea>

                    <div class="rv-small-text" id="processorEvidenceActionHint">
                        <i class="fa-solid fa-circle-info"></i>
                        Evidence is saved automatically when you choose <strong>Require physical inspection</strong>,
                        <strong>Return selected fields to client</strong> or <strong>Submit for OVVIO</strong>.
                    </div>
                </div>

                @if (Model.ProcessorEvidenceFiles == null || !Model.ProcessorEvidenceFiles.Any())
                {
                    <div class="rv-block-note mt-2" id="processorEvidenceEmptyNote">
                        No internal processor evidence has been saved yet. Select a file above; it will be saved with the action you choose below.
                    </div>
                }
                else
                {
                    <div class="rv-ok-note mt-2">
                        <strong>@Model.ProcessorEvidenceFiles.Count internal evidence file(s) recorded.</strong>
                    </div>

                    @foreach (var file in Model.ProcessorEvidenceFiles)
                    {
                        <div class="rv-evidence-item">
                            <div class="rv-evidence-name">@file.FileName</div>
                            <div class="rv-evidence-meta">
                                @(file.UploadedByName ?? "Processor") · @file.UploadedAt.ToString("yyyy-MM-dd HH:mm")
                                @if (!string.IsNullOrWhiteSpace(file.UploadedByRole))
                                {
                                    <text> · @file.UploadedByRole</text>
                                }
                                @if (!string.IsNullOrWhiteSpace(file.EvidenceStage))
                                {
                                    <text> · @file.EvidenceStage</text>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(file.EvidenceComment))
                            {
                                <div class="rv-small-text">@file.EvidenceComment</div>
                            }
                            <div class="mt-1">
                                <a asp-controller="ValuerInbox" asp-action="ProcessorEvidenceFile"
                                   asp-route-attrId="@Model.AttrId" asp-route-evidenceId="@file.Id" target="_blank">View</a>
                                <span> · </span>
                                <a asp-controller="ValuerInbox" asp-action="ProcessorEvidenceFile"
                                   asp-route-attrId="@Model.AttrId" asp-route-evidenceId="@file.Id" asp-route-download="true">Download</a>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="cmp-comments-grid cmp-comments-grid-compact">
            <div class="cmp-comment-card">
                <label for="cmpFinalComment">Your comment</label>
                <textarea id="cmpFinalComment" rows="3" placeholder="e.g.&#10;- Carport count differs, client submitted 2&#10;- Quality rating needs inspection to confirm">@Model.FinalComment</textarea>
                <div class="cmp-comment-hint">Short notes or bullet points are fine — this doesn't need to be a full paragraph.</div>
            </div>
            <div class="cmp-comment-card muted">
                <label>Sector manager comment</label>
                <div>This will be displayed when the submission is selected for Sector Manager QA.</div>
            </div>
        </div>

        <div class="cmp-final-actions">
            @if (Model.ActiveInspectionRequest == null)
            {
                <button type="button" class="cmp-action inspection" id="cmpInspection">
                    <i class="fa-solid fa-house-circle-check"></i>
                    Require physical inspection
                </button>
            }
            else if (string.Equals(Model.ActiveInspectionRequest.Status, "PendingClientResponse", StringComparison.OrdinalIgnoreCase))
            {
                <button type="button" class="cmp-action inspection" disabled
                        title="The client must first select and confirm one of the proposed inspection dates.">
                    <i class="fa-solid fa-hourglass-half"></i>
                    Waiting for client to confirm date
                </button>
            }
            else if (string.Equals(Model.ActiveInspectionRequest.Status, "Confirmed", StringComparison.OrdinalIgnoreCase)
                     && !Model.ActiveInspectionRequest.ValuerDetailsSent)
            {
                <form asp-controller="ValuerInbox"
                      asp-action="SendInspectionDetails"
                      method="post"
                      class="cmp-inline-action-form"
                      onsubmit="return confirm('Generate the inspection PIN and email it to the client?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="inspectionRequestId" value="@Model.ActiveInspectionRequest.Id" />
                    <input type="hidden" name="attrId" value="@Model.AttrId" />
                    <button type="submit" class="cmp-action inspection">
                        <i class="fa-solid fa-key"></i>
                        Generate inspection PIN
                    </button>
                </form>
            }
            else if (string.Equals(Model.ActiveInspectionRequest.Status, "InspectionDetailsSent", StringComparison.OrdinalIgnoreCase)
                     || Model.ActiveInspectionRequest.ValuerDetailsSent)
            {
                <button type="button" class="cmp-action inspection" disabled
                        title="The inspection PIN and valuer details have already been sent to the client.">
                    <i class="fa-solid fa-circle-check"></i>
                    Inspection PIN generated
                </button>
            }
            else if (string.Equals(Model.ActiveInspectionRequest.Status, "Expired", StringComparison.OrdinalIgnoreCase))
            {
                <button type="button" class="cmp-action inspection" id="cmpInspection">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    Send new inspection dates
                </button>
            }
            else
            {
                <button type="button" class="cmp-action inspection" disabled>
                    <i class="fa-solid fa-hourglass-half"></i>
                    Inspection request in progress
                </button>
            }

            <button type="button" class="cmp-action return" id="cmpReturn"
                    disabled="@(string.Equals(Model.Status, "ReadyForOvvioExtract", StringComparison.OrdinalIgnoreCase))">
                <i class="fa-solid fa-rotate-left"></i>
                Return selected fields to client
            </button>
            <button type="button" class="cmp-action ovvio" id="cmpOvvio"
                    disabled="@(!Model.CanSubmitToOvvio || string.Equals(Model.Status, "ReadyForOvvioExtract", StringComparison.OrdinalIgnoreCase))">
                <i class="fa-solid fa-paper-plane"></i>
                Submit for OVVIO
            </button>
        </div>

        @if (!Model.CanSubmitToOvvio && !string.IsNullOrWhiteSpace(Model.SubmitBlockReason))
        {
            <div class="cmp-block-reason">OVVIO submission is blocked: @Model.SubmitBlockReason</div>
        }

        <details class="cmp-timeline">
            <summary>Review audit timeline (@Model.AuditTimeline.Count)</summary>
            @foreach (var audit in Model.AuditTimeline)
            {
                <div class="cmp-audit"><strong>@audit.Action</strong><span>@audit.ActionDateTime.ToString("dd MMM yyyy HH:mm") · @audit.ActionBy</span><small>@audit.Comment</small></div>
            }
        </details>
    </fieldset>
</section>

<div class="cmp-preview-modal" id="cmpPreviewModal" hidden><div class="cmp-preview-dialog"><button type="button" id="cmpPreviewClose">&times;</button><iframe id="cmpPreviewFrame" title="Evidence preview"></iframe><img id="cmpPreviewImage" alt="Evidence preview" /></div></div>
<div class="cmp-confirm-modal" id="cmpConfirmModal" hidden><div class="cmp-confirm-dialog"><h3>Confirm review decision</h3><div id="cmpConfirmSummary"></div><div class="cmp-confirm-buttons"><button type="button" id="cmpConfirmCancel">Cancel</button><button type="button" id="cmpConfirmProceed">Confirm and continue</button></div></div></div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const shell = document.getElementById('attributeComparison');
        if (!shell) return;

        let saveTimer, pendingDecision;
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const processorEvidenceFiles = document.getElementById('processorEvidenceFiles');
        const processorEvidenceComment = document.getElementById('processorEvidenceComment');
        let hasProcessorEvidence = @((Model.ProcessorEvidenceFiles != null && Model.ProcessorEvidenceFiles.Any()).ToString().ToLowerInvariant());
        let evidenceUploadInProgress = false;

        // ── Generic collapsible toggles: 1.1 Lodged evidence, 1.2
        //    Inspection evidence — same open/close behaviour, driven by
        //    data-substep-toggle on each trigger button. ──
        document.querySelectorAll('[data-substep-toggle]').forEach(function (toggle) {
            var key = toggle.getAttribute('data-substep-toggle');
            var body = document.getElementById('substep-' + key);
            if (!body) return;

            toggle.addEventListener('click', function () {
                var isOpen = !body.hidden;
                body.hidden = isOpen;
                toggle.classList.toggle('open', !isOpen);
            });
        });

        var procToggle = document.getElementById('processorEvidenceToggle');
        var procBody = document.getElementById('processorEvidenceBody');
        if (procToggle && procBody) {
            if (hasProcessorEvidence) {
                procBody.hidden = false;
                procToggle.setAttribute('aria-expanded', 'true');
                procToggle.classList.add('open');
            }
            procToggle.addEventListener('click', function () {
                var isOpen = !procBody.hidden;
                procBody.hidden = isOpen;
                procToggle.setAttribute('aria-expanded', (!isOpen).toString());
                procToggle.classList.toggle('open', !isOpen);
            });
        }

        function openProcessorEvidencePanel() {
            if (procBody && procBody.hidden) {
                procBody.hidden = false;
                procToggle?.setAttribute('aria-expanded', 'true');
                procToggle?.classList.add('open');
            }
        }

        async function saveProcessorEvidenceForAction(requireEvidence) {
            if (evidenceUploadInProgress) return false;

            const selectedFiles = processorEvidenceFiles?.files;
            const hasSelectedFiles = selectedFiles && selectedFiles.length > 0;

              if (!hasSelectedFiles) {
        // Internal Processor Evidence is OPTIONAL for all review actions,
        // including Require Physical Inspection.
        // If evidence was already saved, leave it attached to the review.
        // If no evidence was supplied, continue with the selected action.
        return await action();
    }


            const formData = new FormData();
            formData.append('attrId', '@Model.AttrId');
            formData.append('evidenceComment', processorEvidenceComment?.value || '');
            Array.from(selectedFiles).forEach(file => formData.append('files', file));

            evidenceUploadInProgress = true;
            const actionButtons = Array.from(shell.querySelectorAll('.cmp-final-actions button'));
            const actionButtonStates = actionButtons.map(x => ({ element: x, disabled: x.disabled }));
            actionButtons.forEach(x => x.disabled = true);

            try {
                const response = await fetch('@Url.Action("UploadProcessorEvidence", "ValuerInbox")', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token,
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    },
                    body: formData
                });

                let result = null;
                try { result = await response.json(); } catch { }

                if (!response.ok || !result?.success) {
                    throw new Error(result?.message || 'Internal Processor Evidence could not be saved.');
                }

                hasProcessorEvidence = true;
                if (processorEvidenceFiles) processorEvidenceFiles.value = '';
                if (processorEvidenceComment) processorEvidenceComment.value = '';

                const subLabel = document.getElementById('processorEvidenceToggleSub');
                if (subLabel) subLabel.textContent = 'Evidence saved';

                const emptyNote = document.getElementById('processorEvidenceEmptyNote');
                if (emptyNote) {
                    emptyNote.className = 'rv-ok-note mt-2';
                    emptyNote.innerHTML = '<strong>Internal Processor Evidence saved successfully.</strong> It is now part of the processing audit trail.';
                }

                const hint = document.getElementById('processorEvidenceActionHint');
                if (hint) hint.innerHTML = '<i class="fa-solid fa-check"></i> Evidence saved. Continue with the selected processing action.';

                return true;
            } catch (error) {
                alert(error.message || 'Internal Processor Evidence could not be saved.');
                return false;
            } finally {
                evidenceUploadInProgress = false;
                actionButtonStates.forEach(x => x.element.disabled = x.disabled);
            }
        }

        const toggle = document.getElementById('cmpDifferencesOnly');
        function applyFilter() {
            shell.querySelectorAll('.cmp-field-card').forEach(row => {
                row.hidden = !!toggle?.checked && row.dataset.result === 'matching';
            });
        }
        if (toggle) {
            toggle.addEventListener('change', function () { applyFilter(); scheduleSave(); });
            applyFilter();
        }

        const cmpComment = document.getElementById('cmpFinalComment');
        function scheduleSave() { clearTimeout(saveTimer); saveTimer = setTimeout(saveDraft, 700); }
        if (cmpComment) cmpComment.addEventListener('input', scheduleSave);

        async function saveDraft() {
            try {
                await fetch('@Url.Action("AutoSaveDraft", "ValuerInbox")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ reviewId: @Model.ReviewId, attrId: @Model.AttrId, activeTab: '@Model.ActiveTab', valuerComment: cmpComment?.value || '', differencesOnly: toggle?.checked || false })
                });
            } catch (e) { console.warn('Review autosave failed.', e); }
        }

        async function saveCorrections() {
            const keys = Array.from(shell.querySelectorAll('.cmp-correction:checked')).map(x => x.value);
            await fetch('@Url.Action("SaveCorrectionFields", "ValuerInbox")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ reviewId: @Model.ReviewId, attrId: @Model.AttrId, fieldKeys: keys })
            });
        }

        shell.querySelectorAll('.cmp-correction').forEach(x => x.addEventListener('change', saveCorrections));

        shell.querySelectorAll('.cmp-rating-btn').forEach(button => button.addEventListener('click', async function () {
            const host = button.closest('.cmp-rating-resolution');
            const row = button.closest('.cmp-field-card');
            if (!host || !row) return;

            const decision = button.dataset.ratingDecision;
            const buttons = Array.from(host.querySelectorAll('.cmp-rating-btn'));
            buttons.forEach(x => x.disabled = true);

            try {
                const response = await fetch('@Url.Action("ResolveRatingDifference", "ValuerInbox")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({
                        reviewId: @Model.ReviewId,
                        attrId: @Model.AttrId,
                        sectionCode: host.dataset.sectionCode,
                        fieldCode: host.dataset.fieldCode,
                        decision: decision
                    })
                });

                let result = null;
                try { result = await response.json(); } catch { }
                if (!response.ok || !result?.success)
                    throw new Error(result?.message || 'The rating decision could not be saved.');

                row.classList.remove('different');
                row.classList.add('resolved');
                row.dataset.result = 'matching';
                row.dataset.difference = 'false';
                host.innerHTML = decision === 'AcceptClient'
                    ? '<span class="cmp-badge resolved">Client value accepted</span>'
                    : '<span class="cmp-badge resolved">City value retained</span>';

                // Reload so counts, correction state and OVVIO eligibility are recalculated server-side.
                setTimeout(() => window.location.reload(), 300);
            } catch (error) {
                alert(error.message || 'The rating decision could not be saved.');
                buttons.forEach(x => x.disabled = false);
            }
        }));

        function showConfirmation(decision) {
            pendingDecision = decision;
            const selected = shell.querySelectorAll('.cmp-correction:checked').length;
            document.getElementById('cmpConfirmSummary').innerHTML =
                '<p><strong>Decision:</strong> ' + (decision === 'SubmitToOvvio' ? 'Submit for OVVIO' : 'Return to Client') + '</p>' +
                '<p><strong>Differences:</strong> @Model.DifferenceCount</p>' +
                '<p><strong>Selected correction fields:</strong> ' + selected + '</p>' +
                '<p><strong>Comment:</strong> ' + (cmpComment?.value || 'No comment') + '</p>';
            document.getElementById('cmpConfirmModal').hidden = false;
        }

        function submitDecision(decision) {
            const form = document.getElementById('finalReviewForm');
            const target = document.querySelector('#finalReviewForm textarea[name="FinalComment"]');
            if (!form || !target) return;
            target.value = cmpComment?.value || '';
            if (typeof window.setFinalDecision === 'function' && window.setFinalDecision(decision)) form.requestSubmit();
        }

        document.getElementById('cmpInspection')?.addEventListener('click', async () => {
            // Evidence selected above is saved first, then the inspection workflow continues.
            if (!await saveProcessorEvidenceForAction(true)) return;
            if (typeof window.openInspectionModal === 'function') window.openInspectionModal();
        });
        document.getElementById('cmpReturn')?.addEventListener('click', async () => {
            const selected = shell.querySelectorAll('.cmp-correction:checked').length;
            if (selected === 0) {
                alert('Select at least one different field to return to the client.');
                return;
            }
            // Save any selected internal evidence as part of the Return-to-Client action.
            if (!await saveProcessorEvidenceForAction(false)) return;
            showConfirmation('ReturnToClient');
        });
        document.getElementById('cmpOvvio')?.addEventListener('click', async () => {
            // Save any selected internal evidence as part of the OVVIO action.
            if (!await saveProcessorEvidenceForAction(false)) return;
            showConfirmation('SubmitToOvvio');
        });
        document.getElementById('cmpConfirmCancel')?.addEventListener('click', () => document.getElementById('cmpConfirmModal').hidden = true);
        document.getElementById('cmpConfirmProceed')?.addEventListener('click', async function () {
            await saveCorrections();
            document.getElementById('cmpConfirmModal').hidden = true;
            submitDecision(pendingDecision);
        });

        const preview = document.getElementById('cmpPreviewModal'), frame = document.getElementById('cmpPreviewFrame'), image = document.getElementById('cmpPreviewImage');
        shell.querySelectorAll('.cmp-evidence-preview').forEach(button => button.addEventListener('click', function () {
            const isImage = (button.dataset.type || '').startsWith('image/');
            frame.hidden = isImage; image.hidden = !isImage;
            if (isImage) image.src = button.dataset.url; else frame.src = button.dataset.url;
            preview.hidden = false;
        }));
        document.getElementById('cmpPreviewClose')?.addEventListener('click', function () {
            preview.hidden = true; frame.src = 'about:blank'; image.removeAttribute('src');
        });
    });
</script>
