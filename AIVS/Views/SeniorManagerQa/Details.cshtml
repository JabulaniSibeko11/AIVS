@model AIVS.Models.ViewModels.SectorManager.SectorManagerQaDetailsVm
@using AIVS.Workflow
@{
    ViewData["Title"] = "Senior Manager QA " + Model.AttrNo;
    string D(object? value)
    {
        var text = value?.ToString();
        return string.IsNullOrWhiteSpace(text) ? "-" : text;
    }
    var review = Model.ReviewPage;
    var returnLabel = Model.SectorManagerWasProcessor ? "Return to Processor" : "Return to Sector Manager";
    var sectorComment = Model.SectorManagerWasProcessor
        ? "Sector Manager performed the Processor review. Sector Manager QA was skipped and the task was routed directly to Senior Manager QA."
        : D(Model.SectorManagerComment);
}

<link href="~/css/review-page.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/sector-manager-qa.css" rel="stylesheet" asp-append-version="true" />

<div class="rv-page">
    <div class="rv-actions">
        <a class="rv-btn-back" asp-action="Index">Back to Senior Manager QA</a>
        <div class="rv-top-badges">
            <span class="rv-badge">QA Status: @AttributeWorkflowStatus.QaDisplay(Model.SeniorQaStatus, senior: true)</span>
            <span class="rv-badge rv-badge-dark">@Model.AttrNo</span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="rv-alert rv-alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="rv-alert rv-alert-danger">@TempData["Error"]</div>
    }

    <div class="rv-header">
        <div class="rv-title-row">
            <div>
                <h1 class="rv-title">Senior Manager QA: @Model.AttrNo</h1>
                <div class="rv-subtitle">Final QA review of the City-vs-client assessment. Final approval inserts the resolved result into OVVIO staging and generates the client approval notice.</div>
            </div>
            <span class="rv-badge">@D(review?.FormType)</span>
        </div>

        <div class="rv-grid">
            <div class="rv-box"><div class="rv-label">Property</div><div class="rv-value">@D(Model.PropertyDescription)</div></div>
            <div class="rv-box"><div class="rv-label">Township</div><div class="rv-value">@D(Model.Township)</div></div>
            <div class="rv-box"><div class="rv-label">Sector</div><div class="rv-value">@D(Model.Sector)</div></div>
            <div class="rv-box"><div class="rv-label">Processor / Valuer</div><div class="rv-value">@D(Model.ValuerName)</div></div>
            <div class="rv-box"><div class="rv-label">Sector Manager</div><div class="rv-value">@(Model.SectorManagerWasProcessor ? "Processor role - QA skipped" : D(Model.SectorManagerName))</div></div>
        </div>
    </div>

    @if (Model.SectorManagerWasProcessor)
    {
        <div class="rv-alert rv-alert-success">
            <strong>Direct Senior Manager QA:</strong> The Sector Manager performed the processing work, therefore Sector Manager QA was skipped as required.
        </div>
    }

    @{
        ViewData["EvidenceController"] = "SeniorManagerQa";
    }
    @await Html.PartialAsync("~/Views/Shared/_QaReviewComparison.cshtml", Model, ViewData)

    <section class="rv-comment-panel mt-3">
        <div class="rv-comment-grid rv-comment-grid-three">
            <div class="rv-comment-card">
                <div class="rv-comment-title">Valuer / Processor Comment</div>
                <div class="rv-comment-readonly">@D(Model.ValuerFinalComment)</div>
            </div>
            <div class="rv-comment-card">
                <div class="rv-comment-title">Sector Manager Comment</div>
                <div class="rv-comment-readonly">@sectorComment</div>
            </div>
            <div class="rv-comment-card">
                <div class="rv-comment-title">Senior Manager Comment</div>
                <form method="post" id="seniorQaDecisionForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="QaId" value="@Model.QaId" />
                    <input type="hidden" name="AttrId" value="@Model.AttrId" />
                    <textarea name="Comment" class="form-control" rows="6" maxlength="2000" required placeholder="Enter the Senior Manager final QA comment...">@Model.SeniorManagerComment</textarea>
                    <div class="cmp-final-actions mt-3">
                        <button type="submit" class="cmp-action ovvio" formaction="@Url.Action("Approve")" onclick="return confirm('Final approve this submission and insert the resolved attributes into OVVIO staging?');">Final Approve &amp; Submit to OVVIO</button>
                        <button type="submit" class="cmp-action return" formaction="@Url.Action("ReturnToSectorManager")" onclick="return confirm('Return this QA review for correction?');">@returnLabel</button>
                    </div>
                </form>
            </div>
        </div>
    </section>
</div>
