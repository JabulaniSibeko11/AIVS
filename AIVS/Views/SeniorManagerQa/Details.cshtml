@model AIVS.Models.ViewModels.SectorManager.SectorManagerQaDetailsVm
@using AIVS.Workflow
@{
    ViewData["Title"] = "Senior Manager QA " + Model.AttrNo;
    string D(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
}
<link href="~/css/sector-manager-qa.css" rel="stylesheet" asp-append-version="true" />

<div class="smqa-page">
    <div class="smqa-actions-top"><a class="smqa-link-back" asp-action="Index">Back to Senior Manager QA</a></div>
    @if (TempData["Error"] != null)
    {
        <div class="smqa-alert smqa-alert-danger">@TempData["Error"]</div>
    }

    <div class="smqa-header">
        <div><h1>Senior Manager QA: @Model.AttrNo</h1><p>Perform the final QA review. Approval inserts the attributes into OVVIO staging and generates the client approval notice/email.</p></div>
        <div class="smqa-header-count"><strong>@AttributeWorkflowStatus.QaDisplay(Model.SeniorQaStatus, senior: true)</strong> QA status</div>
    </div>

    <div class="smqa-summary-grid">
        <div class="smqa-summary-box"><span>Property</span><strong>@D(Model.PropertyDescription)</strong></div>
        <div class="smqa-summary-box"><span>Sector</span><strong>@D(Model.Sector)</strong></div>
        <div class="smqa-summary-box"><span>Valuer</span><strong>@D(Model.ValuerName)</strong></div>
        <div class="smqa-summary-box"><span>Sector Manager</span><strong>@D(Model.SectorManagerName)</strong></div>
        <div class="smqa-summary-box"><span>Sector Manager Comment</span><strong>@D(Model.SectorManagerComment)</strong></div>
        <div class="smqa-summary-box"><span>Sector QA Completed</span><strong>@(Model.SectorManagerCompletedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</strong></div>
    </div>

    <div class="smqa-layout">
        <main class="smqa-main">
            <div class="smqa-section-card">
                <div class="smqa-section-head"><h3>Review Section Decisions</h3></div><div class="smqa-section-body">
                @foreach (var section in Model.Sections)
                {
                    <div class="smqa-section-decision"><strong>@D(section.SectionName ?? section.SectionCode)</strong><span>@D(section.SectionDecision)</span><small>@D(section.SectionComment)</small></div>
                }
            </div>
        </div>
    </main>
    <aside class="smqa-side">
        <div class="smqa-side-card">
            <div class="smqa-side-head">Client Evidence</div><div class="smqa-side-body">
            @foreach (var file in Model.EvidenceFiles)
            {
                <div class="smqa-file"><strong>@D(file.FileName)</strong><a asp-action="EvidenceFile" asp-route-id="@Model.QaId" asp-route-attrFileId="@file.AttrFileId" asp-route-fileName="@file.FileName" target="_blank">View / Download</a></div>
            }
            @if (!Model.EvidenceFiles.Any())
            {
                <div class="smqa-note">No client evidence available.</div>
            }
        </div>
    </div>
    <div class="smqa-side-card">
        <div class="smqa-side-head">Processor Evidence / Working Papers</div>
        <div class="smqa-side-body">
            @foreach (var file in Model.ProcessorEvidenceFiles)
            {
                <div class="smqa-file">
                    <strong>@D(file.FileName)</strong>
                    <span>@(file.UploadedByName ?? "Processor") · @file.UploadedAt.ToString("yyyy-MM-dd HH:mm") · @D(file.EvidenceStage)</span>
                    @if (!string.IsNullOrWhiteSpace(file.EvidenceComment)) { <small>@file.EvidenceComment</small> }
                    <a asp-action="ProcessorEvidenceFile" asp-route-id="@Model.QaId" asp-route-evidenceId="@file.Id" target="_blank">View</a>
                    <a asp-action="ProcessorEvidenceFile" asp-route-id="@Model.QaId" asp-route-evidenceId="@file.Id" asp-route-download="true">Download</a>
                </div>
            }
            @if (!Model.ProcessorEvidenceFiles.Any())
            {
                <div class="smqa-note">No processor evidence available.</div>
            }
        </div>
    </div>

    <div class="smqa-side-card">
        <div class="smqa-side-head">Final Senior Manager Decision</div><div class="smqa-side-body">
        <form method="post" id="seniorQaForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="QaId" value="@Model.QaId" />
            <input type="hidden" name="AttrId" value="@Model.AttrId" />
            <textarea name="Comment" class="form-control" rows="5" maxlength="2000" required placeholder="Enter the mandatory QA comment"></textarea>
            <button class="smqa-btn mt-3" type="submit" formaction="@Url.Action("Approve")" onclick="return confirm('Final approve this submission, insert the attributes into OVVIO staging, and generate the client approval notice/email?');">Final Approve &amp; Insert to OVVIO</button>
            <button class="smqa-btn mt-2" type="submit" formaction="@Url.Action("ReturnToSectorManager")" onclick="return confirm('Return this QA review to the Sector Manager?');">Return for Correction</button>
        </form>
    </div>
</div>
</aside>
</div>
</div>