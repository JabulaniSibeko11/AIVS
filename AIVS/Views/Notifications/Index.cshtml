@model List<AIVS.Models.ViewModels.Notifications.AivsNotificationVm>

@{
    ViewData["Title"] = "Notifications";

    var unreadCount = Model?.Count(n => !n.IsRead) ?? 0;

    (string Icon, string CssClass) NoteVisual(string? title)
    {
        var t = (title ?? "").ToLowerInvariant();

        if (t.Contains("returned"))
            return ("fa-rotate-left", "notif-danger");
        if (t.Contains("ready") || t.Contains("extract") || t.Contains("confirmed"))
            return ("fa-circle-check", "notif-success");
        if (t.Contains("inspection") || t.Contains("pin") || t.Contains("appointment"))
            return ("fa-calendar-check", "notif-info");
        if (t.Contains("rejected"))
            return ("fa-circle-xmark", "notif-danger");

        return ("fa-bell", "notif-gold");
    }
}

<link href="~/css/notifications.css" rel="stylesheet" asp-append-version="true" />

<div class="aivs-page">

    <div class="aivs-page-header notif-header">
        <div>
            <h1 class="aivs-page-title">Notifications</h1>
            <div class="aivs-page-subtitle">
                Your latest AIVS alerts and updates.
                @if (unreadCount > 0)
                {
                    <span class="notif-unread-chip">@unreadCount unread</span>
                }
            </div>
        </div>

        <form asp-action="MarkAllAsRead" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="notif-btn-mark-all">
                <i class="fa-solid fa-check-double"></i>
                Mark all as read
            </button>
        </form>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="notif-empty">
            <i class="fa-solid fa-bell-slash"></i>
            <h3>No notifications</h3>
            <p>You're all caught up — new alerts will appear here.</p>
        </div>
    }
    else
    {
        <div class="notif-list">
            @foreach (var item in Model)
            {
                var visual = NoteVisual(item.Title);

                <div class="notif-card @(item.IsRead ? "" : "unread") @visual.CssClass">
                    <div class="notif-icon">
                        <i class="fa-solid @visual.Icon"></i>
                    </div>

                    <div class="notif-body">
                        <div class="notif-title-row">
                            <h3 class="notif-title">@item.Title</h3>
                            @if (!item.IsRead)
                            {
                                <span class="notif-dot" title="Unread"></span>
                            }
                        </div>
                        <p class="notif-message">@item.Message</p>
                        <div class="notif-meta">
                            <i class="fa-regular fa-clock"></i>
                            @item.CreatedDateTime.ToString("yyyy-MM-dd HH:mm")
                            @if (!string.IsNullOrWhiteSpace(item.AttrNo))
                            {
                                <span class="notif-meta-ref">@item.AttrNo</span>
                            }
                        </div>
                    </div>

                    <div class="notif-actions">
                        @if (item.AttrId != null)
                        {
                            <a asp-controller="ValuerInbox"
                                   asp-action="Review"
                                   asp-route-id="@item.AttrId"
                                   class="notif-btn-open">
                                Open <i class="fa-solid fa-arrow-right"></i>
                            </a>
                        }

                        @if (!item.IsRead)
                        {
                            <form asp-action="MarkAsRead" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="notif-btn-mark">
                                    Mark read
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
