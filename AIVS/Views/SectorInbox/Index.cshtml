@model AIVS.Models.ViewModels.SectorInbox.SectorInboxPageVm
@using System.Globalization

@{
    ViewData["Title"] = "Sector Inbox";

    string N(int n) => n.ToString("N0", CultureInfo.InvariantCulture);

    var totalAcrossSectors = Model.Tiles.Sum(t => t.Total);
    var maxTileTotal = Model.Tiles.Any() ? Model.Tiles.Max(t => t.Total) : 0;

    string StatusBadgeClass(string? status)
    {
        var s = (status ?? "").Trim().ToUpperInvariant();
        return s switch
        {
            "SECTORINBOX" => "aivs-badge-info",
            "VALUERREVIEW" => "aivs-badge-warning",
            "INSPECTIONREQUIRED" => "aivs-badge-warning",
            "INSPECTIONCONFIRMED" => "aivs-badge-success",
            "INSPECTIONDETAILSSENT" => "aivs-badge-info",
            "INSPECTIONEXPIRED" => "aivs-badge-danger",
            "RETURNEDTOCLIENT" => "aivs-badge-warning",
            "READYFOROVVIOEXTRACT" => "aivs-badge-success",
            "REJECTED" => "aivs-badge-danger",
            _ => "aivs-badge"
        };
    }
}

<link href="~/css/sector-inbox.css" rel="stylesheet" asp-append-version="true"/>

<div class="si-page">
    @if (TempData["Success"] != null)
    {
        <div class="si-banner si-banner-success">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="si-banner si-banner-danger">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" /><path d="M12 8v5M12 16h.01" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg>
            @TempData["Error"]
        </div>
    }

    <div class="aivs-page-header">
        <h1 class="aivs-page-title">Sector Inbox</h1>
        <div class="aivs-page-subtitle">
            Select a sector to view submitted attribute records routed from the City of Johannesburg Valuation Portal.
        </div>
        <div class="si-header-stats">
            <div class="si-header-stat"><strong>@Model.Tiles.Count</strong> sectors</div>
            <div class="si-header-stat"><strong>@N(totalAcrossSectors)</strong> total records routed</div>
        </div>
    </div>

    <div class="si-tiles">
        @foreach (var tile in Model.Tiles)
        {
            var active = string.Equals(Model.SelectedSector, tile.Sector, StringComparison.OrdinalIgnoreCase)
                ? "active"
                : "";
            var barPct = maxTileTotal == 0 ? 0 : (double)tile.Total / maxTileTotal * 100;

            <a class="si-tile @active"
                   asp-controller="SectorInbox"
                   asp-action="Index"
                   asp-route-sector="@tile.Sector">
                <div class="si-tile-name">@tile.Sector</div>
                <div class="si-tile-count">@N(tile.Total)</div>
                <div class="si-tile-label">records in sector inbox</div>
                <div class="si-tile-bar">
                    <div class="si-tile-bar-fill" style="width:@(barPct.ToString("0.###", CultureInfo.InvariantCulture))%;"></div>
                </div>
            </a>
        }
    </div>

    @if (string.IsNullOrWhiteSpace(Model.SelectedSector))
    {
        <div class="si-empty">
            Select a sector tile above to open the routed attribute submissions.
        </div>
    }
    else
    {
        <div class="si-table-card">
            <div class="si-table-title">
                <div>
                    Sector: <span>@Model.SelectedSector</span>
                </div>
                <div class="si-table-title-count">
                    @Model.Items.Count record(s)
                </div>
            </div>

            @if (!Model.Items.Any())
            {
                <div class="si-empty" style="border:0;border-radius:0;">
                    No routed attribute submissions found for @Model.SelectedSector.
                </div>
            }
            else
            {
                @if (Model.CurrentUserCanAssignToValuer)
                {
                    <form asp-controller="SectorInbox"
                          asp-action="AssignSelectedToValuer"
                          method="post"
                          id="assignToValuerForm">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="sector" value="@Model.SelectedSector" />
                    </form>
                }

                <form asp-controller="SectorInbox"
                      asp-action="AssignSelectedToMe"
                      method="post"
                      id="assignSelectedForm">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="sector" value="@Model.SelectedSector" />

                    <div class="si-actions-panel">
                        <div class="si-action-row">
                            <div class="si-bulk-text">
                                <span id="siSelectedCount" class="si-selected-count">0</span> selected &mdash;
                                add them to your Valuer Inbox.
                            </div>

                            <button type="submit"
                                    id="siBulkAssignBtn"
                                    class="si-btn-bulk-assign"
                                    disabled
                                    onclick="return confirmBulkAssign();">
                                Add selected to my inbox
                            </button>
                        </div>

                        @if (Model.CurrentUserCanAssignToValuer)
                        {
                            <div class="si-manager-form">
                                <div class="si-manager-label">
                                    Sector Manager:
                                </div>

                                <select name="selectedValuerUserId"
                                        form="assignToValuerForm"
                                        class="si-manager-select">
                                    <option value="">-- Select Valuer --</option>

                                    @foreach (var valuer in Model.Valuers)
                                    {
                                        <option value="@valuer.UserId">
                                            @valuer.FullName (@valuer.Username)
                                        </option>
                                    }
                                </select>

                                <button type="submit"
                                        id="siManagerAssignBtn"
                                        form="assignToValuerForm"
                                        class="si-btn-manager-assign"
                                        disabled
                                        onclick="return copySelectedAndConfirmManagerAssign();">
                                    Assign selected to valuer
                                </button>
                            </div>
                        }
                    </div>

                    <div class="si-table-scroll">
                        <table class="si-table">
                            <thead>
                                <tr>
                                    <th class="si-check-cell">
                                        <input type="checkbox"
                                               id="selectAllRows"
                                               class="si-check"
                                               onclick="toggleAllRows(this)" />
                                    </th>
                                    <th>Reference No</th>
                                    <th>Property Description</th>
                                    <th>Township</th>
                                    <th>Sector</th>
                                    <th>Submitted</th>
                                    <th>Routed</th>
                                    <th>Evidence</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td class="si-check-cell">
                                            <input type="checkbox"
                                                   name="selectedAttrIds"
                                                   value="@item.AttrId"
                                                   class="si-check row-check" />
                                        </td>
                                        <td class="si-ref">@item.AttrNo</td>
                                        <td>@item.PropertyDescription</td>
                                        <td>@item.Township</td>
                                        <td>@item.RoutedSector</td>
                                        <td class="si-muted">@item.SubmittedDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="si-muted">@(item.RoutedDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                        <td>@item.EvidenceCount</td>
                                        <td>
                                            <span class="aivs-badge @StatusBadgeClass(item.Status)">@item.Status</span>
                                        </td>
                                        <td style="white-space:nowrap;">
                                            <a class="si-btn-view"
                                                   asp-controller="SectorInbox"
                                                   asp-action="Details"
                                                   asp-route-id="@item.AttrId">
                                                View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </form>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function updateSelectionState() {
            var selected = getSelectedRows();
            var count = selected.length;

            var countEl = document.getElementById('siSelectedCount');
            if (countEl) countEl.textContent = count;

            var bulkBtn = document.getElementById('siBulkAssignBtn');
            if (bulkBtn) bulkBtn.disabled = count === 0;

            var managerBtn = document.getElementById('siManagerAssignBtn');
            if (managerBtn) managerBtn.disabled = count === 0;

            document.querySelectorAll('.row-check').forEach(function (checkbox) {
                var row = checkbox.closest('tr');
                if (row) row.classList.toggle('is-selected', checkbox.checked);
            });

            var all = document.querySelectorAll('.row-check');
            var selectAll = document.getElementById('selectAllRows');
            if (selectAll) {
                selectAll.checked = all.length > 0 && count === all.length;
                selectAll.indeterminate = count > 0 && count < all.length;
            }
        }

        function toggleAllRows(source) {
            document.querySelectorAll('.row-check').forEach(function (checkbox) {
                checkbox.checked = source.checked;
            });
            updateSelectionState();
        }

        function getSelectedRows() {
            return Array.from(document.querySelectorAll('.row-check:checked'));
        }

        function confirmBulkAssign() {
            var selected = getSelectedRows().length;

            if (selected === 0) {
                alert('Please select at least one record before assigning.');
                return false;
            }

            return confirm('Assign ' + selected + ' selected item(s) to your inbox?');
        }

        function copySelectedAndConfirmManagerAssign() {
            var selected = getSelectedRows();

            if (selected.length === 0) {
                alert('Please select at least one record before assigning.');
                return false;
            }

            var form = document.getElementById('assignToValuerForm');

            if (!form) {
                alert('The manager assignment form could not be found.');
                return false;
            }

            var valuerSelect = document.querySelector('select[name="selectedValuerUserId"]');

            if (!valuerSelect || !valuerSelect.value) {
                alert('Please select a valuer.');
                return false;
            }

            form.querySelectorAll('input[name="selectedAttrIds"]').forEach(function (x) {
                x.remove();
            });

            selected.forEach(function (checkbox) {
                var hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = 'selectedAttrIds';
                hidden.value = checkbox.value;
                form.appendChild(hidden);
            });

            return confirm('Assign ' + selected.length + ' selected item(s) to the selected valuer?');
        }

        document.addEventListener('change', function (e) {
            if (e.target.classList && e.target.classList.contains('row-check')) {
                updateSelectionState();
            }
        });

        document.addEventListener('DOMContentLoaded', updateSelectionState);
    </script>
}
